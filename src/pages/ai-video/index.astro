---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import ParticleField from '../../components/ParticleField.astro';
import { SITE, YOUTUBE } from '../../data/site';
import { visibleVideoWorks, videoFile, VIDEO_CATEGORIES } from '../../data/videoWorks';

const pageTitle = '熊本のAI動画制作｜撮影なし、最短1週間から会社紹介やPR動画を｜WizTry株式会社';
const pageDescription =
  'WizTry株式会社（熊本）のAI動画制作。映像生成AIや音声AI、音楽生成AIに人の構成と編集を加え、撮影なしで会社紹介や採用PV、商品PR、ショート動画、解説動画をつくります。お手持ちの写真や資料から制作でき、最短1週間から納品します。';

// 強みの見出しは本人指定の4語（撮影なし・最短1週間・低価格・高品質）。金額は出さず理由で説明する
const strengths = [
  {
    icon: '/gen/icon-no-camera.webp',
    en: 'NO SHOOTING',
    title: '撮影なし',
    desc: 'カメラもロケ地も出演者もいりません。伝えたい内容と、お手持ちの写真やロゴ、資料があれば制作を始められます。実在の店舗や商品は、既存の写真を素材にできます。',
  },
  {
    icon: '/gen/icon-fast.webp',
    en: 'FAST DELIVERY',
    title: '最短1週間',
    desc: '撮影の日程調整やロケがないぶん、構成が決まればすぐ制作に入れます。納期は尺や内容、修正回数によって変わるため、ヒアリングの際に具体的な日程をご案内します。',
  },
  {
    icon: '/gen/icon-cost.webp',
    en: 'LOW COST',
    title: '低価格',
    desc: '撮影費やロケ費、出演者や機材の手配がいらないため、そのぶん費用を抑えられます。内容と本数に応じてお見積りしますので、ご予算の目安をお聞かせください。',
  },
  {
    icon: '/gen/icon-quality.webp',
    en: 'HIGH QUALITY',
    title: '高品質',
    desc: '映像生成AIと音声AI、音楽生成AIで素材をつくり、構成と編集、仕上げは人が行います。チームには映像制作を本業とする編集者もおり、AI任せにしない品質を保ちます。',
  },
];

const useCases = [
  { name: '会社紹介と採用の動画', desc: '事業や職場の雰囲気を、写真と資料から動画に。採用サイトや説明会でそのまま使えます。' },
  { name: '商品やサービスのPR', desc: 'お手持ちの商品写真をもとに、動きのあるPR動画にします。展示会やWebサイトでの紹介に。' },
  { name: 'SNSのショート動画', desc: 'リールやショート向けの縦型の短い動画を、複数本まとめて継続的に制作できます。' },
  { name: 'CMやイベント告知', desc: 'セールや催し、新店舗の案内を短い動画に。Webの広告やデジタルサイネージにも使えます。' },
  { name: '解説やマニュアル動画', desc: 'AIアバターと合成音声で、出演者なしの説明動画に。社内研修やお客様向けの使い方案内に。' },
  { name: 'オリジナル曲とMV', desc: '音楽生成AIで会社や商品のテーマ曲をつくり、映像を合わせたミュージックビデオにします。' },
];

const comparison = [
  { item: '準備するもの', shoot: '撮影場所、出演者、機材の手配', ai: '伝えたい内容と写真や資料' },
  { item: '日程', shoot: '撮影日の調整と当日の拘束', ai: '打ち合わせはオンラインでも可' },
  { item: '制作の始まり', shoot: '撮影日を待ってから編集', ai: '構成が決まればすぐ制作' },
  { item: '修正', shoot: '撮り直しが必要な場合も', ai: '素材を作り直して対応' },
  { item: '費用のかかり方', shoot: '撮影費やロケ費、出演料が加わる', ai: '撮影に関わる費用がかからない' },
];

const flow = [
  { step: '01', title: 'ヒアリング', desc: '動画の目的、見せたい相手、使う場所、ご予算と希望の納期をうかがいます。オンラインでも承ります。' },
  { step: '02', title: '構成案', desc: '尺と流れ、ナレーションの文案、使う素材をまとめた構成案をお出しします。ここで方向性を固めます。' },
  { step: '03', title: 'AIで制作', desc: '映像生成AIや音声AI、音楽生成AIで素材をつくり、編集者が構成に沿って組み立てます。' },
  { step: '04', title: '確認と修正', desc: '仕上がりをご確認いただき、修正を反映します。修正の回数と範囲は、事前に取り決めておきます。' },
  { step: '05', title: '納品', desc: '掲載先に合わせた形式とサイズで納品します。WebサイトやSNSでの使い方のご相談も承ります。' },
];

const prepare = [
  { title: '伝えたいこと', desc: '動画で何を、誰に伝えたいか。箇条書きのメモで構いません。' },
  { title: '写真やロゴ', desc: '会社のロゴ、商品や店舗の写真、既存の映像があればお送りください。実在のものを映すときの素材になります。' },
  { title: '原稿や資料', desc: '会社案内やパンフレット、Webサイトの文章など。ナレーションの文案はこちらで作成できます。' },
];

const faq = [
  {
    q: '本当に撮影なしでつくれますか。実在の商品や店舗、社員を映したい場合はどうなりますか。',
    a: 'はい、撮影なしで制作できます。実在の商品や店舗、社員を映したい場合は、お手持ちの写真や既存の映像を素材にしてAIで動画化します。素材の状態によって表現できる範囲が変わりますので、まずはお見せください。',
  },
  {
    q: '費用はどのくらいかかりますか。',
    a: 'お見積りでご案内します。尺と本数、内容（アバターやオリジナル曲の有無など）によって変わります。撮影費やロケ費、出演者の手配がかからないぶん、費用を抑えやすい制作方法です。',
  },
  {
    q: '修正はできますか。',
    a: 'できます。構成案の段階と、仕上がりの確認の段階で、それぞれ確認の場を設けて修正を反映します。修正の回数と範囲は、ご契約の前に取り決めます。',
  },
  {
    q: '納期はどのくらいですか。',
    a: '最短1週間でお届けできます。尺や内容、修正の回数によって変わりますので、ヒアリングの際に具体的な日程をご案内します。お急ぎの場合はその旨をお伝えください。',
  },
  {
    q: '動画の権利や商用利用はどうなりますか。',
    a: '納品した動画の使い方や使える範囲は、制作に使うAIツールの利用規約も確かめたうえで、ご契約の際に取り決めます。お手持ちの写真や音楽を使う場合は、その権利もあわせて確認します。',
  },
  {
    q: 'AIで作ったことを表示する必要はありますか。',
    a: '掲載先の規約やご希望に合わせてご相談します。表示が求められる媒体もありますので、使う場所が決まっていればヒアリングの際にお知らせください。',
  },
];

// 本番は掲載許可済みの作品だけ（videoWorks.ts の permission）
const VIDEO_WORKS = visibleVideoWorks();
const hasWorks = VIDEO_WORKS.length > 0;
const usedCategories = VIDEO_CATEGORIES.filter((c) => VIDEO_WORKS.some((w) => w.category === c));

// SEO: サービス・FAQ・各作品の構造化データ
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI動画制作',
  serviceType: 'AI動画制作',
  description: pageDescription,
  provider: { '@id': `${SITE.domain}/#organization` },
  areaServed: [
    { '@type': 'AdministrativeArea', name: '熊本県' },
    { '@type': 'AdministrativeArea', name: '九州' },
  ],
  url: `${SITE.domain}/ai-video/`,
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const videoLd = VIDEO_WORKS.map((w) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: w.title,
  description: `${w.client}。${w.method}（WizTry株式会社のAI動画制作）`,
  thumbnailUrl: `${SITE.domain}${videoFile(w, 'webp')}`,
  contentUrl: `${SITE.domain}${videoFile(w, 'mp4')}`,
  uploadDate: `${w.date}T00:00:00+09:00`,
  duration: w.durationIso,
}));
---

<Base fullTitle={pageTitle} description={pageDescription} onDark={true} ogImage="/gen/og-ai-video.jpg">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
  {videoLd.map((ld) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />)}

  <!-- ヒーロー: 背景は作品の抜粋をつないだ無音ループ（回線が十分なときだけ読み込む）。無いときは静止画 -->
  <section class="vh-hero">
    <div class="vh-bg" aria-hidden="true"></div>
    <div class="vh-video-slot" aria-hidden="true"></div>
    <div class="vh-veil" aria-hidden="true"></div>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <ParticleField density={6} opacity={0.35} />
    <div class="container vh-inner">
      <p class="vh-label reveal is-in">AI VIDEO PRODUCTION</p>
      <h1 class="vh-title reveal is-in">
        <span class="vh-kicker">AI動画制作</span>
        <span class="vh-line">撮影なしで、</span>
        <span class="vh-line">伝わる動画を。</span>
      </h1>
      <p class="vh-sub reveal is-in">
        映像生成AIと音声AI、音楽生成AIでつくった素材を、映像制作の経験をもつ人の手で仕上げる動画制作です。会社紹介や商品PR、採用、SNS向けの短い動画まで、お手持ちの写真や資料から最短1週間（尺や内容によります）でお届けします。
      </p>
      <ul class="vh-chips reveal is-in" aria-label="AI動画制作の特長">
        {strengths.map((s) => (
          <li><img src={s.icon} alt="" width="28" height="28" decoding="async" />{s.title}</li>
        ))}
      </ul>
      <div class="vh-actions reveal is-in">
        <a href="/contact/" class="btn btn--primary btn--lg">動画制作を相談する <span class="arrow">→</span></a>
        <a href="#works" class="btn btn--ghost-white">制作した動画を見る</a>
      </div>
    </div>
  </section>

  <!-- 強み4つ -->
  <section class="section" id="strengths">
    <div class="container">
      <SectionHead en="WHY AI VIDEO" title="撮影しないから、<span class='nb'>速く、安く、自由に。</span>" lead="WizTryのAI動画制作は、撮影の工程をまるごとAIに置き換えます。浮いた時間と費用を、構成と仕上げの質に回します。" />
      <div class="grid grid--4 vs-grid">
        {strengths.map((s, i) => (
          <article class:list={['card', 'vs-card', 'tilt', 'reveal', `reveal-d${i + 1}`]}>
            <img class="vs-icon" src={s.icon} alt="" width="96" height="96" loading="lazy" decoding="async" />
            <span class="vs-en">{s.en}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 制作実績 -->
  <section class="section section--navy vw-sec" id="works">
    <div class="container">
      <SectionHead en="WORKS" title="制作した動画" lead="WizTryのメンバーがAIで制作した動画です。どれも撮影をせずに、写真や資料、AIで生成した素材から組み立てています。" />

      {hasWorks ? (
        <>
          {usedCategories.length > 1 && (
            <div class="vw-filter reveal" role="group" aria-label="カテゴリで絞り込む">
              <button type="button" class="vw-chip is-active" data-filter="all" aria-pressed="true">すべて</button>
              {usedCategories.map((c) => (
                <button type="button" class="vw-chip" data-filter={c} aria-pressed="false">{c}</button>
              ))}
            </div>
          )}
          <ul class="vw-grid">
            {VIDEO_WORKS.map((w, i) => (
              <li class:list={['vw-item', 'reveal', `reveal-d${(i % 3) + 1}`]} data-category={w.category}>
                <button
                  type="button"
                  class:list={['vw-card', `vw-card--${w.orientation}`]}
                  id={`work-${w.slug}`}
                  data-slug={w.slug}
                  data-src={videoFile(w, 'mp4')}
                  data-poster={videoFile(w, 'webp')}
                  data-title={w.title}
                  data-client={w.client}
                  data-meta={w.method}
                  data-orientation={w.orientation}
                >
                  <span class="vw-poster">
                    {w.orientation === 'portrait' && (
                      <img class="vw-poster-blur" src={videoFile(w, 'webp')} alt="" loading="lazy" decoding="async" />
                    )}
                    <img class="vw-poster-img" src={videoFile(w, 'webp')} alt="" loading="lazy" decoding="async" />
                    <span class="vw-play" aria-hidden="true"><i></i></span>
                    <span class="vw-dur"><span class="sr-only">長さ</span>{w.duration}</span>
                    {w.permission === 'pending' && <span class="vw-pending">掲載確認待ち（本番には出ません）</span>}
                  </span>
                  <span class="vw-body">
                    <span class="vw-cat">{w.category}</span>
                    <span class="vw-title">{w.title}<span class="sr-only">を再生する</span></span>
                    <span class="vw-client">{w.client}</span>
                    <span class="vw-meta">{w.method}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p class="vw-empty reveal">制作実績は準備中です。</p>
      )}
      <p class="vw-note reveal">
        ※掲載している動画は、お客様の許可を得たもの、または自社で制作したもので、AIで生成した映像や音声を含みます。
      </p>
    </div>

    <dialog class="vw-dialog" aria-label="動画の再生">
      <div class="vw-dialog-inner">
        <button type="button" class="vw-close" aria-label="閉じる"><span aria-hidden="true">×</span></button>
        <div class="vw-stage">
          <video controls playsinline preload="none"></video>
        </div>
        <div class="vw-caption">
          <p class="vw-caption-title"></p>
          <p class="vw-caption-meta"><span class="vw-caption-client"></span><span class="vw-caption-method"></span></p>
        </div>
      </div>
    </dialog>
  </section>

  <!-- つくれる動画 -->
  <section class="section" id="use-cases">
    <div class="container">
      <SectionHead en="WHAT WE MAKE" title="こんな動画をつくれます" />
      <div class="grid grid--3 uc-grid">
        {useCases.map((u, i) => (
          <article class:list={['card', 'uc-card', 'reveal', `reveal-d${(i % 3) + 1}`]}>
            <span class="uc-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{u.name}</h3>
            <p>{u.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 撮影する制作との違い -->
  <section class="section section--alt" id="compare">
    <div class="container">
      <SectionHead en="COMPARISON" title="撮影する動画制作との違い" />
      <div class="cmp-wrap reveal">
        <table class="cmp" role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader"><span class="sr-only">項目</span></th>
              <th scope="col" role="columnheader">撮影する制作</th>
              <th scope="col" role="columnheader" class="cmp-ai">WizTryのAI動画制作</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {comparison.map((r) => (
              <tr role="row">
                <th scope="row" role="rowheader">{r.item}</th>
                <td role="cell">{r.shoot}</td>
                <td role="cell" class="cmp-ai">{r.ai}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cmp-note reveal">撮影する制作には、実際の人や場所の空気感をそのまま伝えられる良さがあります。目的に応じて、どちらが合うかもご相談いただけます。</p>
    </div>
  </section>

  <!-- 制作の流れ・ご用意いただくもの -->
  <section class="section" id="flow">
    <div class="container">
      <div class="flow-split">
        <div>
          <SectionHead en="FLOW" title="制作の流れ" />
          <div class="flow">
            {flow.map((f, i) => (
              <div class:list={['flow-step', 'reveal', `reveal-d${(i % 4) + 1}`]}>
                <div class="badge">
                  <small>STEP</small>
                  <span>{f.step}</span>
                </div>
                <div>
                  <h3>{f.title}</h3>
                  <p>{f.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <aside class="prep reveal reveal-d2" aria-labelledby="prep-title">
          <span class="prep-en">PREPARATION</span>
          <h3 id="prep-title">ご用意いただくもの</h3>
          <p class="prep-lead">カメラも、出演する社員も、撮影のために空けていただく日程も必要ありません。</p>
          <ol class="prep-list">
            {prepare.map((p) => (
              <li>
                <strong>{p.title}</strong>
                <span>{p.desc}</span>
              </li>
            ))}
          </ol>
          <figure class="prep-figure">
            <img src="/gen/scene-ai-video.webp" alt="撮影機材を使わず、パソコンの編集画面で動画を仕上げている様子" loading="lazy" decoding="async" />
          </figure>
        </aside>
      </div>
    </div>
  </section>

  <!-- よくある質問 -->
  <section class="section section--alt" id="faq">
    <div class="container">
      <SectionHead en="FAQ" title="よくある質問" center />
      <div class="faq faq-narrow reveal">
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- YouTube -->
  <section class="section section--tight">
    <div class="container">
      <a class="yt-band reveal" href={YOUTUBE.url} target="_blank" rel="noopener">
        <span class="yt-en">YOUTUBE</span>
        <span class="yt-text">
          <strong>AI動画のつくり方は、代表の末松がYouTubeでも発信しています</strong>
          <span>チャンネル「{YOUTUBE.name}」で、映像生成AIの使い方や企業CMのつくり方を紹介しています。</span>
        </span>
        <span class="yt-go">チャンネルを見る <span class="arrow">→</span></span>
      </a>
    </div>
  </section>

  <CtaBand
    title="まずは、つくりたい動画をお聞かせください"
    text="目的と使う場所、ご予算の目安がわかれば、構成の方向性と納期の目安をご提案します。相談は無料です。"
  />
</Base>

<script>
  // ヒーロー背景の作品ダイジェスト: 回線が十分で、省データ・省モーションでない場合だけ読み込む（トップのヒーローと同じ方針）
  function initShowreel() {
    const slot = document.querySelector('.vh-video-slot');
    if (!slot || slot.querySelector('video')) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const conn = (navigator as any).connection;
    if (conn && (conn.saveData || /2g/.test(conn.effectiveType || ''))) return;
    const sp = window.matchMedia('(max-width: 768px)').matches;
    const src = sp ? '/videos/ai-video/showreel-sp.mp4' : '/videos/ai-video/showreel-pc.mp4';
    const v = document.createElement('video');
    v.setAttribute('muted', '');
    v.setAttribute('autoplay', '');
    v.setAttribute('playsinline', '');
    v.setAttribute('loop', '');
    v.muted = true;
    v.loop = true;
    v.preload = 'auto';
    v.src = src;
    v.addEventListener('playing', () => v.classList.add('is-playing'), { once: true });
    v.addEventListener('loadeddata', () => v.classList.add('is-playing'), { once: true });
    v.addEventListener('error', () => v.remove(), { once: true });
    slot.appendChild(v);
    const tryPlay = () => v.play().catch(() => {});
    tryPlay();
    v.addEventListener('canplaythrough', tryPlay, { once: true });
    window.addEventListener('touchend', tryPlay, { once: true, passive: true });
  }

  // 制作実績: カテゴリ絞り込みと、ダイアログでの再生
  function initWorks() {
    const sec = document.querySelector<HTMLElement>('.vw-sec');
    if (!sec || sec.dataset.ready) return;
    sec.dataset.ready = '1';

    const chips = sec.querySelectorAll<HTMLButtonElement>('.vw-chip');
    const items = sec.querySelectorAll<HTMLElement>('.vw-item');
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', String(on));
        });
        items.forEach((it) => {
          it.hidden = !(f === 'all' || it.dataset.category === f);
        });
      })
    );

    const dlg = sec.querySelector<HTMLDialogElement>('.vw-dialog');
    const video = dlg?.querySelector('video');
    const tTitle = dlg?.querySelector('.vw-caption-title');
    const tClient = dlg?.querySelector('.vw-caption-client');
    const tMethod = dlg?.querySelector('.vw-caption-method');
    if (!dlg || !video) return;

    // 背面スクロールの停止を解く。close イベントが届かない環境があるため、閉じる操作ごとに直接呼ぶ
    const release = () => {
      video.pause();
      document.documentElement.style.overflow = '';
    };
    const close = () => {
      release();
      video.removeAttribute('src');
      video.load();
      if (dlg.open) dlg.close();
    };
    const open = (card: HTMLButtonElement) => {
      dlg.dataset.orientation = card.dataset.orientation || 'landscape';
      video.poster = card.dataset.poster || '';
      video.src = card.dataset.src || '';
      if (tTitle) tTitle.textContent = card.dataset.title || '';
      if (tClient) tClient.textContent = card.dataset.client || '';
      if (tMethod) tMethod.textContent = card.dataset.meta || '';
      dlg.showModal();
      // 表示中は背面のページを動かさない（スマホで背面がスクロールするのを防ぐ）
      document.documentElement.style.overflow = 'hidden';
      video.play().catch(() => {});
    };
    sec.querySelectorAll<HTMLButtonElement>('.vw-card').forEach((card) =>
      card.addEventListener('click', () => open(card))
    );
    dlg.querySelector('.vw-close')?.addEventListener('click', close);
    dlg.addEventListener('cancel', release); // Escキー
    dlg.addEventListener('close', release);
    // ?v=<slug> で来たら、その作品を開いた状態にする（サービスページの抜粋から）
    const want = new URLSearchParams(location.search).get('v');
    const target = want ? sec.querySelector<HTMLButtonElement>(`.vw-card[data-slug="${CSS.escape(want)}"]`) : null;
    if (target) {
      target.scrollIntoView({ block: 'center' });
      open(target);
    }
    // 背景（ダイアログの外側）をクリックしたら閉じる
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    document.addEventListener('astro:before-swap', close, { once: true });
  }

  function initAiVideoPage() {
    initShowreel();
    initWorks();
  }
  initAiVideoPage();
  document.addEventListener('astro:page-load', initAiVideoPage);
</script>

