---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Ticks from '../../components/Ticks.astro';
import { SITE } from '../../data/site';
---

<Base
  title="お問い合わせ"
  description="WizTry株式会社へのお問い合わせはこちら。生成AI研修・AIエージェント導入支援・補助金活用など、ご相談は無料です。2営業日以内にご返信します。"
  onDark={true}
>
  <PageHero
    en="CONTACT"
    jp="お問い合わせ"
    desc="ご相談・お見積りは無料です。2営業日以内にご返信します。"
    bg="/gen/ph-contact.webp"
  />

  <section class="section">
    <div class="container">
      <p class="intro reveal">
        「AIで何ができるか知りたい」という段階のご相談も歓迎です。まずはお気軽にご連絡ください。
      </p>

      <div class="contact-layout">
        <form
          id="contact-form"
          class="card card--pad form-grid reveal reveal-d1"
          action="https://formsubmit.co/info@wiztrydx.com"
          method="POST"
        >
          <input type="hidden" name="_next" value={`${SITE.domain}/contact/thanks/`} />
          <input type="hidden" name="_subject" value="【HP】お問い合わせ" />
          <input type="hidden" name="_template" value="table" />

          <div class="field">
            <label for="company">会社名<span class="req">必須</span></label>
            <input type="text" id="company" name="company" required autocomplete="organization" />
          </div>

          <div class="field">
            <label for="name">お名前<span class="req">必須</span></label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="email">メールアドレス<span class="req">必須</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="phone">電話番号<span class="req opt">任意</span></label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>

          <div class="field">
            <label for="category">ご相談内容の種類<span class="req opt">任意</span></label>
            <select id="category" name="category">
              <option value="" selected>選択してください</option>
              <option value="生成AI研修について">生成AI研修について</option>
              <option value="AIエージェント導入について">AIエージェント導入について</option>
              <option value="補助金・助成金について">補助金・助成金について</option>
              <option value="取材・登壇のご依頼">取材・登壇のご依頼</option>
              <option value="その他">その他</option>
            </select>
          </div>

          <div class="field">
            <label for="message">ご相談内容<span class="req">必須</span></label>
            <textarea id="message" name="message" rows="7" required></textarea>
          </div>

          <div class="field consent-field">
            <label class="consent-label">
              <input type="checkbox" name="privacy_agree" required />
              <span><a href="/privacy/">プライバシーポリシー</a>に同意する<span class="req">必須</span></span>
            </label>
          </div>

          <div class="field">
            <button type="submit" id="contact-submit" class="btn btn--primary btn--lg">問い合わせを送信 <span class="arrow">→</span></button>
            <p class="form-error" id="contact-error" role="alert" hidden>
              送信できませんでした。恐れ入りますが、時間をおいて再度お試しいただくか、お電話（{SITE.tel}）またはメール（{SITE.email}）で直接ご連絡ください。
            </p>
            <p class="submit-note">万一、送信後に英語の認証画面が表示された場合は、「私はロボットではありません」にチェックを入れてください。</p>
          </div>
        </form>

        <aside class="contact-aside reveal reveal-d2">
          <div class="contact-panel">
            <div class="aurora" aria-hidden="true"><i></i><i></i></div>
            <Ticks />
            <div class="panel-inner">
              <span class="en-label">DIRECT CONTACT</span>
              <h3>お電話・メールでも受け付けています</h3>
              <p class="panel-lead">
                フォームのご利用が難しい場合は、お電話または下記メールアドレスへ直接ご連絡ください。
              </p>
              <div class="panel-actions">
                <a href={`tel:${SITE.tel.replaceAll('-', '')}`} class="btn btn--ghost-white">{SITE.tel}</a>
                <a href={`mailto:${SITE.email}`} class="btn btn--ghost-white">{SITE.email}</a>
              </div>
              <p class="panel-note">2営業日以内にご返信します</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  // FormSubmitへAJAXで直接送信し、英語のreCAPTCHA中間画面を経由せずに完了させる。
  // fetch自体が失敗した場合のみ従来のPOST（認証画面あり）へフォールバックして取りこぼしを防ぐ。
  // ClientRouterの遷移でbodyが差し替わるため、astro:page-loadごとに付け直す（Base.astroと同じ流儀）。
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const errorBox = document.getElementById('contact-error');
    if (!form || !submitBtn || !errorBox || form.dataset.ajaxBound) return;
    form.dataset.ajaxBound = 'true';

    const AJAX_ENDPOINT = 'https://formsubmit.co/ajax/info@wiztrydx.com';
    let sending = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      sending = true;
      errorBox.hidden = true;

      const originalLabel = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.textContent = '送信中…';

      try {
        const res = await fetch(AJAX_ENDPOINT, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => null);

        if (res.ok && data && String(data.success) === 'true') {
          window.location.href = '/contact/thanks/';
          return;
        }
        // FormSubmit側で受理されなかった: 日本語で案内し、直接連絡の導線を出す
        errorBox.hidden = false;
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalLabel;
        sending = false;
      } catch {
        // ネットワーク層の失敗のみ、従来のPOST送信（認証画面あり）で救済する。
        // form.submit() はsubmitイベントを発火しないため、このハンドラは再実行されない。
        form.submit();
      }
    });
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .intro {
    color: var(--ink-soft);
    max-width: 44em;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(24px, 3vw, 40px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .contact-layout { grid-template-columns: 1fr; }
  }

  /* 送信ボタンだけ他フィールドよりひと呼吸あける */
  .form-grid .field:last-child { margin-top: 6px; }
  .form-error {
    margin: 14px 0 0;
    padding: 12px 14px;
    border: 1px solid #e5484d;
    border-radius: 8px;
    background: rgba(229, 72, 77, 0.06);
    color: #c62a30;
    font-size: 14px;
    line-height: 1.8;
  }
  .submit-note {
    margin: 12px 0 0;
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.7;
  }

  /* ---------- 右サイド: ダークネイビーパネル ---------- */
  .contact-panel {
    /* sticky自体が位置指定要素なので、Ticks/auroraの絶対配置の基準になる */
    position: sticky;
    top: calc(var(--header-h) + 24px);
    overflow: hidden;
    isolation: isolate;
    background: var(--bg-navy-grad);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(30px, 3.2vw, 40px);
    box-shadow: var(--shadow-md);
  }
  /* 上辺のアクセントヘアライン */
  .contact-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--accent-grad);
    z-index: 3;
  }
  /* 共通auroraを小さめのパネル用に調整（色はglobalのまま） */
  .contact-panel .aurora i {
    filter: blur(56px);
    opacity: 0.4;
  }
  .contact-panel .aurora i:nth-child(1) {
    width: 260px; height: 260px; top: -110px; right: -80px;
  }
  .contact-panel .aurora i:nth-child(2) {
    width: 220px; height: 220px; bottom: -100px; left: -70px;
  }

  .panel-inner { position: relative; z-index: 2; }
  .panel-inner .en-label { display: block; }
  .contact-panel h3 {
    font-size: 18px;
    line-height: 1.65;
    color: #fff;
    margin: 14px 0 12px;
  }
  .panel-lead {
    color: rgba(255, 255, 255, 0.75);
    font-size: 14.5px;
    line-height: 1.9;
    margin: 0;
  }
  .panel-actions {
    display: grid;
    gap: 12px;
    margin-top: 26px;
  }
  .panel-actions .btn {
    display: flex;
    width: 100%;
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .panel-note {
    margin: 24px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 13px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
  }
  @media (max-width: 860px) {
    /* 1カラム時はフォームの下に通常配置（stickyは効かせない） */
    .contact-panel { position: relative; top: auto; }
  }

  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-weight: 500;
    font-size: 14.5px;
    cursor: pointer;
  }
  .consent-label input[type='checkbox'] {
    width: 18px;
    height: 18px;
    flex: none;
    margin-top: 2px;
    accent-color: var(--blue-500);
  }
  .consent-label a { color: var(--blue-500); text-decoration: underline; text-underline-offset: 3px; }
</style>
