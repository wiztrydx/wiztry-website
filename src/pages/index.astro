  .hm-worry-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 24px); }
  .hm-worry-card { display: flex; flex-direction: column; padding: 26px 22px 24px; color: inherit; text-decoration: none; }
