---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import LogoWall from '../components/LogoWall.astro';
import Stats from '../components/Stats.astro';
import ParticleField from '../components/ParticleField.astro';
import Ticks from '../components/Ticks.astro';
import { NEWS, YOUTUBE_CHANNELS, SITE } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// お知らせ・メディア掲載: 新しい順に直近だけ載せ、全量は会社案内ページへ
const news = [...NEWS].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6);
const fmtNewsDate = (d: string) => d.replaceAll('-', '.');

// 紹介いただいた媒体・公的機関。お知らせの台帳（site.ts の NEWS）から重複を除いて拾うので、足すときは台帳に書く
const outlets = [
  ...new Set(
    NEWS.filter((n) => n.outlet && (n.category === 'メディア掲載' || n.category === '公的機関・自治体')).map((n) => n.outlet),
  ),
];

// 書き方の決まり（このページ全体）:
// - 研修を「貴社に合わせて作る」「実際の書類を教材にする」と読める言い方をしない（業種別の事例を体系化した教材・職種や役割別のコース、と書く）
// - 補助金・助成金は「対象となる場合がある」「制度のご案内」まで。申請の代行・書類づくりを請け負うと読める言い方、補助率の数字、無料・実質負担の話は書かない
// - 金額・最上級の表現（No.1 など）は書かない。数字には時点か出どころを添える

const WORRIES = [
  {
    icon: 'icon-worry-team',
    title: '使っているのは、一部の社員だけ',
    body: 'ChatGPTやGeminiを入れたものの、全社には広がらない。',
    answer: '対面のハンズオン研修で、全員が自分のパソコンで手を動かします',
    href: '/service/#training',
  },
  {
    icon: 'icon-worry-start',
    title: '何から始めればいいか分からない',
    body: 'ツールが多くて選べない。社内に詳しい人もいない。',
    answer: '今の状況を伺い、最初の一歩を一緒に決めます（ご相談は無料）',
    href: '/contact/',
  },
  {
    icon: 'icon-worry-time',
    title: '人手が足りず、定型業務に追われている',
    body: '集計・転記・資料づくりに、毎日時間を取られる。',
    answer: '繰り返しの業務を、AIエージェントで自動化します',
    href: '/service/#agent',
  },
  {
    icon: 'icon-worry-rule',
    title: '情報漏えいが心配で、踏み出せない',
    body: '何を入力してよいのか、社内の線引きがあいまい。',
    answer: 'AIの答えの確かめ方から、管理者向けの設定まで研修で扱います',
    href: '/kumamoto-ai-training/',
  },
];

const REASONS = [
  {
    title: '講師が隣で教える、対面ハンズオン',
    body: '動画を見るだけの研修は、手が止まったところで終わってしまいます。WizTryの研修は、講師が会場へ伺い、受講者が自分のパソコンで操作しながら進める形式です。つまずいたその場で解決するので、パソコンに慣れていない方も置いていきません。',
    chips: ['熊本県内全域へ訪問', '1回2時間・全4〜10回', 'オンライン併用も可'],
    img: '/photos/training-handson.webp',
    sm: '/photos/training-handson-sm.webp',
    w: 1800,
    h: 1350,
    alt: '少人数で机を囲み、受講者がそれぞれのノートパソコンで生成AIを操作している研修の様子（受講者のお顔は加工しています）',
  },
  {
    title: '100社超えの現場で磨いた教材',
    body: '不動産・建設・製造・医療・小売など、12を超える業種の企業を支援する中で集まった活用事例と知見を、教材として体系化しています。職種や役割に応じたコースをご用意し、ChatGPT・Gemini・Claudeのいずれにも対応します。',
    chips: ['累計100社超えを支援', '12業種以上', 'ChatGPT・Gemini・Claude'],
    img: '/photos/seminar-podium.webp',
    w: 1800,
    h: 1350,
    alt: '代表の末松が、多くの参加者を前に生成AIのセミナーで登壇している様子',
  },
  {
    title: '自社でも、毎日AIを動かしている',
    body: 'WizTryは、営業資料や研修資料の作成、メール返信の下書き、請求書の作成、問い合わせの一次対応まで、自社の実務をAIエージェントに任せています。だから研修では実際に使っている方法をお伝えでき、導入支援では止まりやすい所まで先回りできます。',
    chips: ['Claude Code・Codex', 'Dify・GAS', '研修から導入・運用まで'],
    img: '/gen/agent-night-office.webp',
    w: 1024,
    h: 1024,
    alt: '人のいない夜のオフィスで、複数のAIエージェントが業務を進めているイメージ',
  },
];

// 成果の例。出どころは /works/ の事例（企業名は出さない）。数字を変えるときは /works/ と一緒に直す
const CASES = [
  {
    tag: 'ハウスメーカー ／ AIエージェント導入',
    figure: '月20時間以上',
    figureLabel: '一人あたりの業務時間を削減',
    body: '業務エージェントを導入し、空いた時間をお客様対応と提案に。社内のAI活用が一気に進みました。',
    img: '/gen/case-housemaker.webp',
    alt: 'ハウスメーカーのAIエージェント導入による業務削減のイメージ',
  },
  {
    tag: '不動産 ／ 全社員研修',
    figure: '約40名',
    figureLabel: '全社で受講し、2期目も継続',
    body: 'Gemini for Google Workspaceの研修を全社で実施。文書作成と情報共有が速くなり、翌年も継続のご依頼をいただきました。',
    img: '/gen/case-realestate.webp',
    alt: '不動産会社の全社員向け生成AI研修のイメージ',
  },
  {
    tag: '電気設備工事 ／ 集中育成',
    figure: '全6回・12時間',
    figureLabel: '現場の中核メンバー12名が受講',
    body: 'Gemini for Google Workspaceのハンズオン講座で、現場部門の中核メンバーを育成。研修後に継続のご依頼もいただきました。',
    img: '/gen/case-electric.webp',
    alt: '電気設備工事会社の現場メンバー向け生成AIハンズオン研修のイメージ',
  },
];

// 自社での実践。数字と注記は /kumamoto-ai-agent/ ・ /kumamoto-ai-training/ と同じもの。片方だけ変えない
const PRACTICE = [
  { value: 8, unit: '割以上', label: '実務のうち、AIエージェントが担う割合', note: '※2026年7月時点の社内集計' },
  { value: 18, unit: '本', label: '時間になると自動で動く定時業務', note: '' },
  { value: 10, unit: '名分', label: '担当を分けて動かしている「AI社員」', note: '' },
];

const FLOW = [
  { title: '無料相談', body: 'フォームからご連絡ください。2営業日以内にご返信します。「何から始めるか決まっていない」段階でも大丈夫です。' },
  { title: 'お打ち合わせ', body: 'オンラインまたは対面で、今の状況と目的を伺います。熊本県内は訪問も可能です。' },
  { title: 'ご提案・お見積り', body: '研修はコースと回数・日程を、導入支援は対象の業務と進め方をご提案します。お見積りまで無料です。' },
  { title: '開始', body: '研修は対面ハンズオンで実施。導入支援は、まず1つの業務で試作し、効果を確かめてから広げます。' },
];

const FAQS = [
  {
    q: 'WizTryはどんな会社ですか？',
    a: '熊本市に本社を置く、生成AI研修とAIエージェント導入支援の会社です（2023年7月設立）。講師が会場へ伺う対面ハンズオン研修と、Claude Code・Codexなどで業務を自動化するAIエージェントの構築を行っています。累計の支援企業数は100社超え（2026年11月時点）です。',
  },
  {
    q: '熊本市以外や、県外でも依頼できますか？',
    a: '可能です。熊本市を拠点に、熊本県内全域へお伺いしています。近県での開催や、オンラインでの実施もご相談ください。',
  },
  {
    q: '研修は何名から、何回から実施できますか？',
    a: '少人数の集中育成から、約40名規模の全社研修まで対応しています。全4〜10回・1回2時間程度の構成が中心です。',
  },
  {
    q: 'どのAIツールに対応していますか？',
    a: 'ChatGPT・Google Gemini・Claudeに対応しています。Google Workspaceを導入済みの企業向けには、Gemini for Google Workspaceの研修もご用意しています。',
  },
  {
    q: 'パソコンが苦手な社員が多くても大丈夫ですか？',
    a: '大丈夫です。講師がすぐ隣でサポートする対面ハンズオン形式なので、ITに不慣れな方も置いていかれません。幅広い年代・職種の方に受講いただいています。',
  },
  {
    q: '費用はどのくらいですか？',
    a: '人数・回数・実施の形式によってお見積りします。ご相談とお見積りは無料で、お問い合わせから2営業日以内にご返信します。',
  },
  {
    q: '補助金・助成金は使えますか？',
    a: '研修は、公的な補助金・助成金の対象となる場合があります。対象になるかどうかは、各制度の要件と審査によります。WizTryからは、制度の概要と、研修の内容・日程など研修側でご用意する資料をご案内します。申請の手続きは、受講される企業様、または社会保険労務士などの専門家が行います。',
  },
  {
    q: '研修ではなく、業務の自動化だけを相談できますか？',
    a: 'できます。問い合わせの一次対応、資料作成、データ集計など、繰り返し発生する業務が対象です。まず1つの業務で試作し、効果を確かめてから広げる進め方をおすすめしています。',
  },
];

// よくある質問の構造化データ（本文と同じ文面をそのまま入れる）
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base onDark={true}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
  <!-- LCP改善: CSS背景のヒーロー画像はブラウザの発見が遅いため先読みする -->
  <link slot="head" rel="preload" as="image" href="/gen/hero-ai-wave.webp" fetchpriority="high" />
  <!-- 1-1 Hero -->
  <section class="hero">
    <div class="hero-video-slot" aria-hidden="true"></div>
    <div class="hero-beams" aria-hidden="true" data-plx="7"><i></i><i></i></div>
    <div class="hero-lights" aria-hidden="true" data-plx="15"><i></i><i></i><i></i><i></i></div>
    <div class="hero-streaks" aria-hidden="true" data-plx="10"><i></i><i></i><i></i></div>
    <ParticleField density={13} opacity={0.6} />
    <div class="container hero-inner">
      <div class="hero-copy reveal">
        <span class="hero-label">KUMAMOTO × GENERATIVE AI</span>
        {/* キネティックタイトル: 1文字ずつマスクから立ち上がる。分割はビルド時に行いCLSゼロ */}
        <h1 class="hero-title">
          {['生成AIを、', '事業の力に。'].map((line, li) => (
            <span class="line" style={`--l:${li}`}>
              {[...line].map((ch, ci) => (
                <span class="ch" style={`--i:${ci}`}>{ch}</span>
              ))}
            </span>
          ))}
        </h1>
        <p class="hero-sub">
          熊本の生成AI研修・AIエージェント導入支援の会社です。講師が隣で教える対面ハンズオン研修と、Claude
          Code・Codexで日々の業務を自動化するAIエージェントの構築。熊本を中心に、累計100社超えの企業を支援しています。
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn--primary btn--lg">無料で相談する <span class="arrow">→</span></a>
          <a href="/service/" class="btn btn--ghost-white">サービスを見る</a>
          <ul class="hero-assure">
            <li>ご相談・お見積りは無料</li>
            <li>2営業日以内にご返信</li>
            <li>熊本県内全域へ訪問・オンラインも可</li>
          </ul>
        </div>
      </div>
      <div class="scroll-indicator" aria-hidden="true">
        <span class="si-text">SCROLL</span>
        <span class="si-track"><i class="si-comet"></i></span>
        <span class="si-ring"></span>
      </div>
    </div>
    <div class="hero-stats reveal reveal-d2">
      <div class="container">
        <Stats />
      </div>
    </div>
  </section>

  <!-- 1-1b メディア掲載・公的機関でのご紹介（文字だけ。媒体のロゴは使わない） -->
  <section class="hm-press" aria-label="メディア掲載・公的機関でのご紹介">
    <div class="container">
      <div class="hm-press-inner reveal">
        <p class="hm-press-label">メディア掲載・公的機関でのご紹介</p>
        <ul class="hm-press-list">
          {outlets.map((o) => (
            <li>{o}</li>
          ))}
        </ul>
        <a href="/media/" class="hm-press-more">一覧を見る <span class="arrow">→</span></a>
      </div>
      <p class="hm-press-note">※自社で運営する「くまもと被災者支援ナビ」「くまもと応援ナビ」のご紹介を含みます</p>
    </div>
  </section>

  <!-- 1-2 よくあるお悩み -->
  <section class="section section--alt hm-worry">
    <div class="container">
      <SectionHead
        en="ISSUES"
        title="こんなお悩みは、ありませんか"
        lead="生成AIのご相談でよく伺うのは、次の4つです。どれも、進め方が決まれば動き出せます。"
        center
      />
      <div class="hm-worry-grid">
        {
          WORRIES.map((w, i) => (
            <a href={w.href} class:list={['card', 'hm-worry-card', 'reveal', `reveal-d${i + 1}`]}>
              <img src={`/gen/${w.icon}.webp`} alt="" width="360" height="360" decoding="async" />
              <h3>{w.title}</h3>
              <p class="hm-worry-q">{w.body}</p>
              <p class="hm-worry-a">
                <span>WizTryでは</span>
                {w.answer}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 1-3 選ばれる理由 -->
  <section class="section hm-why">
    <div class="container">
      <SectionHead en="WHY WIZTRY" title="WizTryが選ばれる、3つの理由" />
      <div class="hm-why-rows">
        {
          REASONS.map((r, i) => (
            <article class:list={['hm-why-row', 'reveal', { 'hm-why-row--rev': i % 2 === 1 }]}>
              <div class="hm-why-media zoom-media">
                <img
                  src={r.img}
                  srcset={'sm' in r ? `${r.sm} 900w, ${r.img} ${r.w}w` : undefined}
                  sizes={'sm' in r ? '(max-width: 900px) 92vw, 560px' : undefined}
                  alt={r.alt}
                  width={r.w}
                  height={r.h}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="hm-why-body">
                <span class="hm-why-num">{`0${i + 1}`}</span>
                <h3>{r.title}</h3>
                <p>{r.body}</p>
                <ul class="hm-chips">
                  {r.chips.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 1-4 サービス4本柱（研修・導入支援・ホームページ制作・AI動画制作） -->
  <section class="section section--deco" style="padding-top: clamp(40px, 5vw, 64px);">
    <div class="ticker" aria-hidden="true" style="margin-bottom: clamp(40px, 6vw, 72px);">
      <span>AI TRAINING&nbsp;/&nbsp;AI AGENT&nbsp;/&nbsp;WEB&nbsp;/&nbsp;AI VIDEO&nbsp;/&nbsp;KUMAMOTO&nbsp;/&nbsp;AI TRAINING&nbsp;/&nbsp;AI AGENT&nbsp;/&nbsp;WEB&nbsp;/&nbsp;AI VIDEO&nbsp;/&nbsp;KUMAMOTO&nbsp;/&nbsp;</span>
    </div>
    <div class="container">
      <SectionHead en="SERVICE" title="事業内容" />
      <div class="grid grid--2">
        <a href="/service/#training" class="card service-card tilt reveal reveal-d1">
          <div class="zoom-media"><img src="/gen/scene-training.webp" alt="講師が隣で伴走する対面ハンズオン形式の生成AI研修" loading="lazy" decoding="async" /></div>
          <div class="service-card-body">
            <h3>生成AI導入研修</h3>
            <p>
              ChatGPT・Gemini・Claude・Codexなどの生成AIを、業種別の活用事例を体系化したカリキュラムで。基礎の使い方から、GAS・Difyを使った業務自動化まで、対面ハンズオンで確実に定着させます。
            </p>
            <span class="link-arrow">詳しく見る <span class="arrow">→</span></span>
          </div>
        </a>
        <a href="/service/#agent" class="card service-card tilt reveal reveal-d2">
          <div class="zoom-media"><img src="/gen/scene-agent-dev.webp" alt="実務を自動化するAIエージェントの開発イメージ" loading="lazy" decoding="async" /></div>
          <div class="service-card-body">
            <h3>AIエージェント導入支援</h3>
            <p>
              Claude Code・Codexを核に、貴社の実務を自動化する高度なAIエージェントを構築。要件整理からPoC、本番運用、運用後の伴走まで一貫して支援します。
            </p>
            <span class="link-arrow">詳しく見る <span class="arrow">→</span></span>
          </div>
        </a>
        <a href="/service/#web" class="card service-card tilt reveal reveal-d1">
          <div class="zoom-media"><img src="/gen/scene-web-dev.webp" alt="パソコンとスマートフォンで、制作中のホームページの表示を確かめている様子" loading="lazy" decoding="async" /></div>
          <div class="service-card-body">
            <h3>ホームページ制作</h3>
            <p>
              会社の顔となるホームページを、AIを使って原稿づくりから更新まで速く。スマホ対応と検索エンジン向けの基本設計を標準で備えます。
            </p>
            <span class="link-arrow">詳しく見る <span class="arrow">→</span></span>
          </div>
        </a>
        <a href="/ai-video/" class="card service-card tilt reveal reveal-d2">
          <div class="zoom-media service-card-media--new">
            <img src="/gen/scene-ai-video.webp" alt="撮影機材を使わず、パソコンの編集画面で動画を仕上げている様子" loading="lazy" decoding="async" />
            <span class="service-new">NEW</span>
          </div>
          <div class="service-card-body">
            <h3>AI動画制作</h3>
            <p>
              映像生成AIと音声AIでつくった素材を人の手で仕上げる、撮影なしの動画制作。会社紹介や商品PR、SNS向けの短い動画を、最短1週間（尺や内容による）からお届けします。
            </p>
            <span class="link-arrow">詳しく見る <span class="arrow">→</span></span>
          </div>
        </a>
      </div>
      <p class="service-subsidy-note reveal reveal-d3">
        熊本県内の企業様向けには、<a href="/kumamoto-ai-training/">熊本の生成AI研修</a>と<a href="/kumamoto-ai-agent/">熊本のAIエージェント導入支援</a>の専用ページもご用意しています
      </p>
      <p class="service-subsidy-note reveal reveal-d3">
        研修は、公的な補助金・助成金の対象となる場合があります（可否は各制度の要件・審査によります）
        <a href="/service/#subsidy">制度のご案内 <span class="arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- 1-4b 実績ロゴ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="CLIENTS"
        title="導入企業様（一部）"
        lead="業種・業界を問わず、熊本を中心に多くの企業様にご利用いただいています。"
      />
      <LogoWall mode="marquee" />
      <div class="text-center mt-64">
        <a href="/works/" class="btn btn--ghost">導入実績を見る <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

