  /* ---------- Numbers ---------- */
  .numbers-sec {
    position: relative;
    background:
      linear-gradient(rgba(10, 22, 48, 0.82), rgba(10, 22, 48, 0.88)),
      url('/gen/neural-grid.webp') center / cover no-repeat, var(--bg-navy-grad);
    overflow: hidden;
  }
  /* モバイル: 画面に入ると数字カードが順にカスケード点灯。
     独自JSではなく全ページ実績のあるリビール機構(.is-in)に遅延を足すだけの方式 */
  @media (max-width: 768px) {
    .numbers-sec .stat.reveal {
      opacity: 0.12;
      transform: translateY(18px) scale(0.97);
      transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .numbers-sec .stat.reveal.is-in {
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
    .numbers-sec .stat.reveal.is-in:nth-child(2) { transition-delay: 0.22s; }
    .numbers-sec .stat.reveal.is-in:nth-child(3) { transition-delay: 0.44s; }
    .numbers-sec .stat.reveal.is-in:nth-child(4) { transition-delay: 0.66s; }
  }
  .numbers-sec .stat {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: var(--radius);
    padding: 26px 14px;
    backdrop-filter: blur(6px);
  }

  /* ---------- Media list ---------- */
  .media-list {
