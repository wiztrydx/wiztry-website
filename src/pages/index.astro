  /* 成果の例 */
  .hm-case { display: flex; flex-direction: column; overflow: hidden; color: inherit; text-decoration: none; }
  .hm-case .zoom-media img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .hm-case-body { padding: 22px 24px 26px; display: grid; gap: 10px; }
  .hm-case-tag { font-size: 12.5px; font-weight: 700; color: var(--blue-500); letter-spacing: 0.04em; }
