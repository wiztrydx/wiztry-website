<script>
  // ヒーロー動画: 回線が十分で、省データ/省モーションでない場合だけ読み込む。
  // ※事前のHEAD存在チェックは廃止 — GitHub PagesがHEADに時々503を返し、
  //   その瞬間に来た訪問者は動画ヒーローが永久に出なくなっていた。
  //   ファイルはサイトと一緒にデプロイされるので存在確認は不要。失敗時はerrorイベントで静かに撤去する。
  function initHeroVideo() {
    const slot = document.querySelector('.hero-video-slot');
    if (!slot || slot.querySelector('video')) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const conn = (navigator as any).connection;
    if (conn && (conn.saveData || /2g/.test(conn.effectiveType || ''))) return;
    const sp = window.matchMedia('(max-width: 768px)').matches;
    const src = sp ? '/videos/hero-sp.mp4' : '/videos/hero-pc.mp4';
    const v = document.createElement('video');
    // 自動再生の条件はプロパティではなく「属性」で判定するブラウザがあるため両方設定
    v.setAttribute('muted', '');
    v.setAttribute('autoplay', '');
    v.setAttribute('playsinline', '');
    v.setAttribute('loop', '');
    v.muted = true;
    v.loop = true;
    v.preload = 'auto';
    v.src = src;
    // 表示の点火は「再生開始」だけでなく「最初のフレーム取得」でも行う。
    // iOS低電力モード等で自動再生がブロックされても、静止した1フレーム目が
    // ヒーロー画像として見える（＝動画が丸ごと消えたように見えない）
    v.addEventListener('playing', () => v.classList.add('is-playing'), { once: true });
    v.addEventListener('loadeddata', () => v.classList.add('is-playing'), { once: true });
    // 読み込み失敗（配信側の一時的な503など）は1回だけリトライしてから諦める
    let retried = false;
    v.addEventListener('error', () => {
      if (retried) { v.remove(); return; }
      retried = true;
      setTimeout(() => { v.src = `${src}?r=1`; v.load(); tryPlay(); }, 1500);
    });
    slot.appendChild(v);
    const tryPlay = () => v.play().catch(() => {});
    tryPlay();
    v.addEventListener('canplaythrough', tryPlay, { once: true });
    setTimeout(() => { if (v.paused) tryPlay(); }, 1200);
    // 自動再生ブロック環境では、最初のタップで再生を試みる（1回だけ・静かに）
    window.addEventListener('touchend', tryPlay, { once: true, passive: true });
  }
  initHeroVideo();
  document.addEventListener('astro:page-load', initHeroVideo);

  // ヒーロー文字アニメの点火: ローダー表示中はその退場を待ってから開始
  function armHeroIntro() {
    const hero = document.querySelector('.hero');
    if (!hero || hero.classList.contains('hero-in')) return;
    const fire = () =>
      setTimeout(() => {
        hero.classList.add('hero-in');
        // 保険: 何らかの理由でCSSアニメが走らない環境でも文字を必ず表示する
        // （タイトルは文字分割になったため、旧来のopacity機構が残るサブ文で判定する）
        setTimeout(() => {
          const sub = hero.querySelector('.hero-sub');
          if (sub && getComputedStyle(sub).opacity === '0') hero.classList.add('hero-static');
        }, 2600);
      }, 80);
    const loader = document.getElementById('siteLoader');
    if (!loader) {
      fire();
      return;
    }
    const mo = new MutationObserver(() => {
      if (!document.getElementById('siteLoader')) {
        mo.disconnect();
        fire();
      }
    });
    mo.observe(document.body, { childList: true });
    setTimeout(() => { mo.disconnect(); fire(); }, 3500); // 保険
  }
  armHeroIntro();
  document.addEventListener('astro:page-load', armHeroIntro);

  // ヒーローのマウス追従パララックス（精密ポインタのみ・軽量lerp）
  function initHeroParallax() {
    if (!window.matchMedia('(pointer: fine)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero || hero.dataset.plxReady) return;
    hero.dataset.plxReady = '1';
    const els = hero.querySelectorAll<HTMLElement>('[data-plx]');
    if (!els.length) return;
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
    const loop = () => {
      cx += (tx - cx) * 0.06;
      cy += (ty - cy) * 0.06;
      els.forEach((el) => {
        const f = parseFloat(el.dataset.plx || '10');
        el.style.transform = `translate3d(${(cx * f).toFixed(2)}px, ${(cy * f).toFixed(2)}px, 0)`;
      });
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = requestAnimationFrame(loop);
      else raf = 0;
    };
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      tx = e.clientX / r.width - 0.5;
      ty = (e.clientY - r.top) / r.height - 0.5;
      if (!raf) raf = requestAnimationFrame(loop);
    });
  }
  initHeroParallax();
  document.addEventListener('astro:page-load', initHeroParallax);
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    color: #fff;
    padding-top: var(--header-h);
    background: var(--navy-950);
    overflow: hidden;
  }
  /* 背景画像: スロー・ケンバーンズズーム */
  .hero::before {
    content: '';
    position: absolute;
    inset: -4%;
    background: url('/gen/hero-ai-wave.webp') center / cover no-repeat;
    animation: heroZoom 22s ease-in-out infinite alternate;
    will-change: transform;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(5, 13, 30, 0.9) 0%, rgba(10, 22, 48, 0.55) 45%, rgba(10, 22, 48, 0.12) 100%);
  }
  @keyframes heroZoom {
    from { transform: scale(1) translate(0, 0); }
    to { transform: scale(1.14) translate(-1.2%, -2.2%); }
  }
  .hero :global(.particle-canvas) { z-index: 2; }

  /* ヒーロー動画（/videos/hero-pc.mp4, hero-sp.mp4 を置くと自動で有効化） */
  .hero-video-slot { position: absolute; inset: 0; overflow: hidden; }
  .hero-video-slot :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero-video-slot :global(video.is-playing) { opacity: 1; }
  /* スマホ: 縦長画面のcoverで左右が切れるため、動きのある右側の粒子が見えるよう右寄りを表示
     （＝映像を左に寄せる）。さらに少し寄った画角から、同じ位置を基点にゆっくり呼吸ズーム */
  @media (max-width: 768px) {
    .hero-video-slot :global(video) {
      object-position: 80% 90%;
      transform-origin: 80% 90%;
      animation: spVideoZoom 16s ease-in-out infinite alternate;
      /* 白飛び抑えの減光（粒子が多い素材なので少し深めに落として文字を立てる） */
      filter: brightness(0.88);
    }
  }
  @keyframes spVideoZoom {
    from { transform: scale(1.02); }
    to { transform: scale(1.14); }
  }
  /* スマホ: 合成専用に生成した高級テクスチャ（夜景オフィス×ホログラフィックライン×金のボケ）を
     スクリーン合成。明部だけが乗るので粒子の動きは殺さない。9:16設計なので継ぎ目なし */
  @media (max-width: 768px) {
    .hero-video-slot::after {
      content: '';
      position: absolute;
      inset: 0;
      background: url('/gen/hero-overlay-sp.webp') left top / cover no-repeat;
      mix-blend-mode: screen;
      opacity: 0.65;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video-slot :global(video) { animation: none; transform: none; }
  }

  /* 回転する光のビーム（コニックグラデーション2枚が逆回転） */
  .hero-beams {
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: screen;
    pointer-events: none;
    overflow: hidden;
  }
  .hero-beams i {
    position: absolute;
    width: 160vmax;
    height: 160vmax;
    top: 50%;
    left: 68%;
    margin: -80vmax 0 0 -80vmax;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.5;
  }
  .hero-beams i:nth-child(1) {
    background: conic-gradient(
      transparent 0deg, transparent 40deg,
      rgba(47, 107, 255, 0.28) 60deg, transparent 85deg,
      transparent 180deg, rgba(55, 200, 240, 0.2) 205deg, transparent 230deg, transparent 360deg
    );
    animation: beamSpin 34s linear infinite;
  }
  .hero-beams i:nth-child(2) {
    background: conic-gradient(
      transparent 0deg, rgba(55, 200, 240, 0.16) 25deg, transparent 55deg,
      transparent 200deg, rgba(90, 140, 255, 0.18) 230deg, transparent 260deg, transparent 360deg
    );
    animation: beamSpin 46s linear infinite reverse;
  }
  @keyframes beamSpin { to { transform: rotate(360deg); } }

  /* 流れる光のストリーク（データ彗星） */
  .hero-streaks {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }
  .hero-streaks i {
    position: absolute;
    width: 220px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, rgba(150, 210, 255, 0.9), #fff);
    filter: drop-shadow(0 0 6px rgba(55, 200, 240, 0.9));
    transform: rotate(-24deg);
    opacity: 0;
    animation: streak 7s ease-in infinite;
  }
  .hero-streaks i:nth-child(1) { top: 18%; left: 58%; animation-delay: 1.2s; }
  .hero-streaks i:nth-child(2) { top: 42%; left: 74%; animation-delay: 3.8s; animation-duration: 8.5s; width: 160px; }
  .hero-streaks i:nth-child(3) { top: 8%; left: 80%; animation-delay: 6.2s; animation-duration: 9.5s; width: 130px; }
  @keyframes streak {
    0%, 88% { opacity: 0; transform: rotate(-24deg) translateX(0); }
    90% { opacity: 1; }
    100% { opacity: 0; transform: rotate(-24deg) translateX(-46vw); }
  }

  /* スクロールでヒーローの文字がゆっくり退場（対応ブラウザのみ） */
  @supports (animation-timeline: view()) {
    .hero-copy {
      animation: heroExit linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 70%;
    }
  }
  @keyframes heroExit {
    to { opacity: 0; transform: translateY(-46px); }
  }

  /* 漂う光（screen合成でヒーローの光源が呼吸するように動く） */
  .hero-lights {
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .hero-lights i {
    position: absolute;
    border-radius: 50%;
    filter: blur(56px);
  }
  .hero-lights i:nth-child(1) {
    width: 560px; height: 560px; top: 2%; right: 2%;
    background: radial-gradient(circle, rgba(55, 200, 240, 0.5), transparent 66%);
    animation: lightA 10s ease-in-out infinite alternate;
  }
  .hero-lights i:nth-child(2) {
    width: 420px; height: 420px; bottom: 6%; right: 26%;
    background: radial-gradient(circle, rgba(47, 107, 255, 0.55), transparent 66%);
    animation: lightB 13s ease-in-out infinite alternate;
  }
  .hero-lights i:nth-child(3) {
    width: 320px; height: 320px; top: 34%; left: 34%;
    background: radial-gradient(circle, rgba(130, 170, 255, 0.4), transparent 66%);
    animation: lightC 16s ease-in-out infinite alternate;
  }
  .hero-lights i:nth-child(4) {
    width: 240px; height: 240px; top: 12%; left: 6%;
    background: radial-gradient(circle, rgba(55, 200, 240, 0.3), transparent 66%);
    animation: lightB 19s ease-in-out infinite alternate-reverse;
  }
  @keyframes lightA {
    from { transform: translate(0, 0) scale(1); opacity: 0.55; }
    50% { opacity: 0.95; }
    to { transform: translate(-90px, 70px) scale(1.22); opacity: 0.65; }
  }
  @keyframes lightB {
    from { transform: translate(0, 0) scale(1); opacity: 0.5; }
    50% { opacity: 0.9; }
    to { transform: translate(70px, -60px) scale(1.18); opacity: 0.6; }
  }
  @keyframes lightC {
    from { transform: translate(0, 0) scale(0.9); opacity: 0.35; }
    50% { opacity: 0.8; }
    to { transform: translate(-60px, -50px) scale(1.25); opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero::before, .hero-lights i, .hero-beams i, .hero-streaks i, .hero-copy { animation: none; }
  }
  .hero-inner {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 3;
  }
  .hero-copy {
    max-width: 720px;
    padding-block: clamp(44px, 8vw, 72px);
  }
  /* 段階フェードイン: ページが実際に見えてから（.hero-in付与後に）開始する。
     読み込み中にアニメが終わってしまう問題への対策
     ※タイトルは文字単位のマスク出現に変更したためこのグループから外している */
  .hero-label, .hero-sub, .hero-actions {
    opacity: 0;
    transform: translateY(26px);
  }
  .hero.hero-in .hero-label,
  .hero.hero-in .hero-sub,
  .hero.hero-in .hero-actions {
    animation: heroRise 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero.hero-in .hero-sub { animation-delay: 0.44s; }
  .hero.hero-in .hero-actions { animation-delay: 0.62s; }
  @keyframes heroRise {
    to { opacity: 1; transform: none; }
  }
  /* キネティックタイトル: 行ごとのoverflowマスク内で文字が立ち上がる */
  .hero-title .line { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .hero-title .ch {
    display: inline-block;
    transform: translateY(115%) rotate(4deg);
    will-change: transform;
  }
  .hero.hero-in .hero-title .ch {
    animation: chRise 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(0.08s + var(--l, 0) * 0.22s + var(--i, 0) * 0.045s);
  }
  @keyframes chRise {
    to { transform: translateY(0) rotate(0deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-label, .hero-sub, .hero-actions { opacity: 1; transform: none; }
    .hero-title .ch { transform: none; animation: none; }
  }
  /* アニメ非動作環境の保険 */
  .hero.hero-static .hero-label,
  .hero.hero-static .hero-sub,
  .hero.hero-static .hero-actions {
    animation: none;
    opacity: 1;
    transform: none;
  }
  .hero.hero-static .hero-title .ch {
    animation: none;
    transform: none;
  }
  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cyan-400);
    margin-bottom: 24px;
  }
  .hero-label::before {
    content: '';
    width: 34px;
    height: 2px;
    background: var(--accent-grad);
    border-radius: 2px;
  }
  /* ターミナルの入力カーソル風の点滅ブロック */
  .hero-label::after {
    content: '';
    width: 8px;
    height: 14px;
    background: var(--cyan-400);
    animation: caretBlink 1.15s steps(1) infinite;
  }
  @keyframes caretBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-label::after { animation: none; }
  }
  .hero-title {
    color: #fff;
    font-size: clamp(40px, 6.2vw, 74px);
    font-weight: 900;
    letter-spacing: 0.01em;
  }
  .hero-sub {
    margin-top: 28px;
    max-width: 46em;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.86);
  }
  .hero-actions {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .hero-stats {
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(5, 13, 30, 0.32);
    backdrop-filter: blur(6px);
    padding-block: clamp(28px, 4vw, 40px);
    position: relative;
    z-index: 3;
  }
  .scroll-indicator {
    position: absolute;
    right: 0;
    bottom: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, 0.65);
  }
  .si-text {
    writing-mode: vertical-rl;
    font-family: var(--font-en);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.34em;
    animation: siGlow 2.6s ease-in-out infinite;
  }
  /* 光の彗星が線路を流れ落ちる */
  .si-track {
    position: relative;
    display: block;
    width: 2px;
    height: 64px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }
  .si-comet {
    position: absolute;
    left: 0;
    top: -40%;
    width: 100%;
    height: 40%;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, var(--cyan-400) 60%, #fff);
    box-shadow: 0 0 10px rgba(55, 200, 240, 0.9);
    animation: siComet 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  /* 着地点で波紋が広がる */
  .si-ring {
    position: relative;
    display: block;
    width: 7px;
    height: 7px;
  }
  .si-ring::before,
  .si-ring::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .si-ring::before {
    background: var(--cyan-400);
    box-shadow: 0 0 8px rgba(55, 200, 240, 0.9);
    animation: siGlow 2.6s ease-in-out infinite;
  }
  .si-ring::after {
    border: 1.5px solid rgba(55, 200, 240, 0.8);
    animation: siRipple 2.6s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
  }
  @keyframes siComet {
    0% { top: -45%; opacity: 0; }
    12% { opacity: 1; }
    78% { top: 105%; opacity: 1; }
    100% { top: 105%; opacity: 0; }
  }
  @keyframes siRipple {
    0%, 55% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(3.4); opacity: 0; }
  }
  @keyframes siGlow {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }
  @media (max-width: 760px) {
    .scroll-indicator {
      display: none;
    }
  }
  /* モバイル軽量モード: blurフィルタ（GPU高負荷）だけを外し、
     radial-gradient自体の柔らかさで発光を表現。動き（transform/opacity）は全部残す */
  @media (max-width: 768px) {
    .hero-lights i {
      filter: none;
      width: 300px;
      height: 300px;
    }
    .hero-lights i:nth-child(3),
    .hero-lights i:nth-child(4) {
      display: none;
    }
    .hero-beams i {
      filter: none;
      opacity: 0.3;
    }
    .hero-beams i:nth-child(2) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .si-comet, .si-ring::after, .si-ring::before, .si-text { animation: none; }
  }

  /* ---------- Service pillar cards ---------- */
  .service-card {
