---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';

// 「熊本 AI導入支援」「熊本 AIコンサル」「熊本 業務効率化 AI」「熊本 AI 導入 費用」の検索意図に応える専用ページ。
// /kumamoto-ai-training/ は「人が使えるようになる（研修）」、このページは「システムが動く（導入・自動化）」で
// 求める成果物が別物なため、ページを分ける正当性がある（地域名差し替えの量産ページではない）。
//
// 費用について: 金額は出さない方針（光太郎くん判断 2026-07-25）。
// かわりに「いま手作業にかかっている時間を人件費に換算する」考え方を示して判断材料にする。

const painPoints = [
  {
    q: '毎月おなじ資料を、人が手で作り直している',
    a: '定型の報告書・請求書・日報のような「フォーマットが決まっている仕事」は、AIエージェントがもっとも得意とする領域です。',
  },
  {
    q: '問い合わせ対応で、担当者の時間が溶けていく',
    a: '過去のやりとりと社内文書を読み込ませた一次対応の仕組みをつくると、人が判断すべき案件だけが手元に残ります。',
  },
  {
    q: 'AIを入れたいが、どの業務からやるべきか分からない',
    a: 'ここが最初の分かれ道です。効果が出る業務には共通の条件があるため、洗い出しと優先順位付けから一緒に行います。',
  },
];

// 「AIオフィス」の4段階。自社（WizTry）で実際に動かしている仕組みをそのまま説明する構成。
// 出典は自社ブログ /blog/ai-shain-tsukurikata/（AI社員10名の実録）。
// Google公式が「効く」と明言している一次情報（first-hand）にあたるため、他社が書けない中身にする。
const officeStages = [
  {
    num: '01',
    label: '整理整頓',
    title: '会社の情報を、AIが読める形に整える',
    body:
      'AIエージェントが働けない一番の理由は、AIの性能ではありません。<em>読むものが社内にない</em>ことです。人間の新入社員に業務マニュアルも議事録も渡さず「察して動け」と言っても無理なのと同じです。まずは会社の知識を、AIが毎回読み返せる形に整えます。',
    detail: [
      '判断の基準になる「会社の事実」を書き出す（事業内容、商品、お客様への言葉遣い、やってはいけないこと）',
      '散らばっている業務マニュアル・議事録・過去のやりとりを1か所に集める',
      '中身は特別な形式にしない。ただのテキストファイルにしておくと、どのAIでもそのまま読める',
    ],
    note:
      'すでに業務マニュアルや議事録があるなら、AIエージェントの教科書は半分できています。ゼロから発明する話ではありません。',
  },
  {
    num: '02',
    label: 'ナレッジ構造',
    title: '3層構造で「会社の資料室」をつくる',
    body:
      '集めただけでは使えません。AIが迷わず必要な情報にたどり着けるよう、階層を決めます。弊社が自社で運用している資料室は、この3層だけです。特別なシステムではなく、<em>フォルダとファイルの集まり</em>です。',
    detail: [
      '第1層 全社ルール — 誰が読んでも守れる決まりごと（例「メール返信は過去のやりとりを引用する」「ログイン情報には触らない」）',
      '第2層 部署のルール — 部署ごとに1枚。研修・営業・マーケティング・バックオフィスなど',
      '第3層 仕事の手順書 — 見積の作り方、日程調整の段取り、資料の作り方。新入社員に渡す業務マニュアルと同じもの',
    ],
    note:
      '大事なのは、ここにネットの一般論を入れないことです。入れると「一般的には正しいが自社では間違い」の答えが返ってくるようになります。入れるのは自社の事実だけです。',
  },
  {
    num: '03',
    label: 'AIオフィス',
    title: '担当を分けて、動く時間を決める',
    body:
      '資料室が整ったら、そこで働く「担当」を配置します。ポイントは<em>1人に1つの担当を持たせる</em>ことです。担当を曖昧にしたまま何でも頼むと、AIも人と同じで仕事が雑になります。',
    detail: [
      '業務ごとに担当を切る（メール担当、資料作成担当、議事録担当、日報担当など）',
      '定時業務として時間割を決める（朝の報告、会議後のフォロー、夜の記録整理など）',
      '毎日の記録が資料室に書き戻る設計にする。放っておいても会社の記憶が積み上がる状態をつくる',
    ],
    note:
      '弊社では担当ごとに名前を付けて10名分を運用しています。遊びに見えますが、「誰の仕事か」を曖昧にしないための実務上の工夫です。',
  },
  {
    num: '04',
    label: '安全な仕組み',
    title: '「関所」を決めてから、任せ切る',
    body:
      '最後に安全設計です。弊社の考え方は<em>AIが最後まで走り、外に出る直前に必ず人間の関所を通る</em>です。関所を増やしすぎると人間が渋滞の原因になり、少なすぎると事故が起きます。だから関所は3つに絞ります。',
    detail: [
      '外に出るもの（メール・SNS・公開文書）— AIは下書きまで。送信ボタンは人間が押す',
      'お金と契約（見積・請求・申込）— 数字は人間が検算してから確定する',
      '初めてやる種類の仕事 — 最初の1回だけ人間が横で見る',
    ],
    note:
      'あわせて、機密情報は最初から別フォルダに分けて通常業務で読む範囲を決めます。そして間違いが出たら叱るのではなくルールに書き足します。間違いの9割は、指示とルールの穴です。',
  },
];

// 費用の考え方: 金額ではなく「換算のしかた」と「確認すべき費用項目」を示す
const costItems = [
  {
    title: '初期構築',
    desc: '業務の洗い出し、試作、本番の作り込み。対象業務の数と、既存システムとつなぐ必要があるかで変わります。',
  },
  {
    title: '運用・改善',
    desc: '動かし始めてからの調整、対象業務の追加、モデル更新への追随。作って終わりにしないための費用です。',
  },
  {
    title: 'AIサービスの利用料',
    desc: 'ChatGPT・Gemini・ClaudeなどのAPIやプラン料金。使う人数と処理量で決まり、当社への支払いとは別枠です。',
  },
];

const stack = [
  { name: 'Claude Code', desc: 'コードを書いて動かすAIエージェント。業務ツールの自作と自動化の中核' },
  { name: 'Codex', desc: 'OpenAIの開発エージェント。既存コードの改修や検証に併用' },
  { name: 'Dify', desc: '社内文書を読み込ませたチャットボットの構築' },
  { name: 'Google Apps Script', desc: 'スプレッドシート・Gmail・カレンダーの自動連携' },
  { name: 'Gemini API / Google Workspace', desc: '普段使いのツールの中にAIを組み込む' },
];

const flow = [
  { step: '01', title: '課題ヒアリング', desc: '自動化する業務を洗い出し、効果と実現しやすさで優先順位をつけます。ここで「やらない業務」も決めます。' },
  { step: '02', title: 'PoC・試作', desc: '小さく作って、実際の業務データで効果を確認します。ここで見込みが立たなければ、本番に進みません。' },
  { step: '03', title: '本番構築', desc: '業務フローに組み込み、担当者が日常的に使える形にして社内展開します。' },
  { step: '04', title: '運用伴走', desc: '使われ方を見ながら改善し、対象業務を広げます。AI顧問として継続的にご相談いただけます。' },
];

const faq = [
  {
    q: '熊本のどのエリアまで対応していますか?',
    a: '熊本市に拠点があり、熊本県内全域へお伺いしています。打ち合わせは対面・オンラインのどちらでも可能で、構築作業自体はオンライン中心で進むため、遠方でも進行に支障はありません。近県のご相談も承ります。',
  },
  {
    q: 'AI導入の費用はどのくらいかかりますか?',
    a: '対象業務の数、既存システムとの連携の有無、運用をどこまでお任せいただくかで大きく変わるため、内容をお伺いしてからお見積りします。判断材料として、いま手作業にかかっている時間を人件費に換算してみるのが有効です。たとえば月20時間かかっている作業があれば、その担当者の時間単価×20時間が毎月消えている計算になります。ご相談時にこの試算からご一緒します。',
  },
  {
    q: '何から始めればいいですか?',
    a: 'まずは「毎月・毎週おなじ手順で繰り返している作業」を1つ挙げてください。頻度が高く手順が決まっている業務ほど、効果がはっきり出ます。逆に、毎回判断が変わる業務は最初の対象に向きません。',
  },
  {
    q: '小さく試すことはできますか?',
    a: 'できます。むしろ推奨しています。最初に1業務でPoC（試作）をつくり、実際の効果を確認してから広げる進め方です。見込みが立たなければ本番構築に進まない判断も含めてご提案します。',
  },
  {
    q: '社内にITに詳しい人がいなくても大丈夫ですか?',
    a: '大丈夫です。むしろ多くのお客様がその状態から始めています。仕組みは私たちが構築し、担当者の方には「使う」ところだけをお願いします。必要に応じて社内向けの操作説明も行います。',
  },
  {
    q: '研修とどちらを先にやるべきですか?',
    a: '社員が日常業務でAIを使えるようになりたいなら研修から、特定の業務を確実に自動化したいなら導入支援からです。両方をご希望の場合は、研修で全体のリテラシーを上げながら、並行して効果の大きい業務を自動化する進め方が多いです。',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '熊本の企業向けAIエージェント導入支援・業務自動化',
  serviceType: 'AIエージェント開発・業務自動化・AI導入コンサルティング',
  provider: { '@type': 'Organization', name: 'WizTry株式会社', url: 'https://wiztrydx.com' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: '熊本県' },
    { '@type': 'City', name: '熊本市' },
  ],
  description:
    '熊本の企業向けにAIエージェントの構築と業務自動化を支援。Claude Code・Codex・Dify・GASを用いて、問い合わせ対応・資料作成・データ集計などの定型業務を自動化します。小さく試して効果を確認してから本番構築へ進みます。',
  url: 'https://wiztrydx.com/kumamoto-ai-agent/',
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://wiztrydx.com/' },
    { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://wiztrydx.com/service/' },
    { '@type': 'ListItem', position: 3, name: '熊本のAIエージェント導入支援' },
  ],
};
---

<Base
  title="熊本のAIエージェント導入支援・業務自動化"
  description="熊本の企業向けAI導入支援。Claude Code・Codex・Dify・GASで問い合わせ対応や資料作成、データ集計などの定型業務を自動化します。小さく試して効果を確認してから本番構築。熊本県内全域に対応。"
  onDark={true}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />

  <PageHero
    en="AI AGENT"
    jp="熊本のAIエージェント導入支援"
    desc="人を増やさずに、仕事の量を減らす。熊本の企業の定型業務を、AIエージェントで自動化します。"
    bg="/gen/scene-agent-dev.webp"
  />

  <!-- 導入 -->
  <section class="section">
    <div class="container narrow-copy">
      <p class="lead-copy reveal">
        人手不足は、採用だけでは解決しなくなりました。募集しても応募が来ない。来ても育つまで時間がかかる。その一方で、<em>人がやらなくてもいい仕事</em>が現場を圧迫し続けています。
      </p>
      <p class="lead-copy reveal reveal-d1">
        WizTryのAIエージェント導入支援は、この「人がやらなくてもいい仕事」を仕組みに置き換える支援です。研修が<em>人が使えるようになる</em>ための取り組みなら、こちらは<em>システムが動くようになる</em>ための取り組みです。
      </p>
    </div>
  </section>

  <!-- こんな状態から始まります -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="SYMPTOMS"
        title="こんな状態から始まります"
        lead="ご相談の入口として多いのは、この3つです。"
      />
      <div class="pain-list">
        {
          painPoints.map((p, i) => (
            <div class={`pain-item reveal reveal-d${i + 1}`}>
              <p class="pain-q">「{p.q}」</p>
              <p class="pain-a">{p.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- AIオフィスの作り方（中核セクション） -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="AI OFFICE"
        title="AIオフィスの作り方——4つの段階"
        lead="個別の作業を自動化して終わりにはしません。社員の代わりにAIが働ける「オフィス」そのものをつくります。弊社が自社で毎日動かしている仕組みを、そのままお客様の会社に移植する考え方です。"
      />

      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          先に結論から言います。AIエージェントの本体は、高価なシステムでもオーダーメイドの開発でもありません。<em>会社の知識が整理された、ただのフォルダとファイルの集まり</em>です。
        </p>
        <p class="lead-copy reveal reveal-d1">
          弊社で起きているのは「AIが賢いから会社が回る」ではなく、<em>「資料室が揃っているから、どのAIが来ても同じ品質で働ける」</em>という状態です。だから順番が大事で、道具の導入から始めると、ほぼ失敗します。
        </p>
      </div>

      <div class="stages">
        {
          officeStages.map((s) => (
            <article class="stage reveal">
              <header class="stage-head">
                <span class="stage-num">{s.num}</span>
                <span class="stage-label">{s.label}</span>
                <h3 class="stage-title">{s.title}</h3>
              </header>
              <p class="stage-body" set:html={s.body} />
              <ul class="stage-detail">
                {s.detail.map((d) => <li>{d}</li>)}
              </ul>
              <p class="stage-note">{s.note}</p>
            </article>
          ))
        }
      </div>

      <div class="container narrow-copy">
        <h3 class="block-title reveal mt-64">この4段階を通すと、何が起きるか</h3>
        <p class="lead-copy reveal">
          弊社の実例です。現在は担当を分けた10名体制で、毎日・毎週・毎月の定時業務が<em>18本</em>動いています。朝の承認待ち報告、会議直後の次アクションとお礼メールの下書き、夜の録画整理、その日の日報。
        </p>
        <p class="lead-copy reveal reveal-d1">
          直近2週間の記録では、会社の資料への保存・更新が<em>279回</em>ありました。そのうち<em>約4割は、人間が何も指示していない時間帯にAIだけで動いたもの</em>です。これが「社員の代わりに働く」の実態です。
        </p>
        <p class="to-service reveal">
          <a href="/blog/ai-shain-tsukurikata/">弊社のAI社員10名の実録を読む <span class="arrow">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- 費用の考え方 -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="COST"
        title="費用の考え方"
        lead="金額は対象業務の数と連携範囲で変わるためお見積りになりますが、判断のしかたは先にお伝えできます。"
      />
      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          いちばん確実なのは、<em>いま手作業にかかっている時間を人件費に換算してみること</em>です。月20時間かかっている作業があれば、その担当者の時間単価×20時間が、毎月消えていることになります。年間なら240時間です。
        </p>
        <p class="lead-copy reveal reveal-d1">
          この「消えている金額」と、自動化にかかる費用を並べたときに前者が明らかに大きければ、投資判断はしやすくなります。ご相談時には、この試算からご一緒します。
        </p>
      </div>
      <h3 class="block-title reveal mt-64">確認しておきたい費用の内訳</h3>
      <div class="grid grid--3">
        {
          costItems.map((c, i) => (
            <div class={`card cost-card reveal reveal-d${i + 1}`}>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="cost-note reveal">
        AIサービスの利用料は当社への支払いとは別枠です。ここを混ぜて説明されると総額が見えなくなるため、切り分けてご案内しています。
      </p>
    </div>
  </section>

  <!-- 技術スタック -->
  <section class="section section--navy">
    <div class="container">
      <SectionHead
        en="STACK"
        title="使用する技術"
        lead="流行りのツールを並べるのではなく、実際の業務に組み込んで運用しているものだけを使います。"
      />
      <div class="stack-list">
        {
          stack.map((s, i) => (
            <div class={`stack-item reveal reveal-d${(i % 3) + 1}`}>
              <span class="stack-name">{s.name}</span>
              <span class="stack-desc">{s.desc}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 進め方 -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="FLOW"
        title="進め方"
        lead="小さく試して、効果を確認してから広げます。最初から全社展開はしません。"
      />
      <div class="grid grid--4">
        {
          flow.map((f, i) => (
            <div class={`card flow-card reveal reveal-d${i + 1}`}>
              <span class="flow-step">{f.step}</span>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 研修との違い -->
  <section class="section section--alt">
    <div class="container narrow-copy">
      <SectionHead en="OR TRAINING" title="研修とどう違うのか" />
      <p class="lead-copy reveal">
        <em>研修</em>は、社員がAIを使えるようになるための取り組みです。手を動かせる人が増えるほど、現場の判断が速くなります。
      </p>
      <p class="lead-copy reveal reveal-d1">
        <em>導入支援</em>は、特定の業務を確実に自動化するための取り組みです。担当者が変わっても仕組みは動き続けます。
      </p>
      <p class="lead-copy reveal reveal-d2">
        どちらが先かは目的によります。迷われる場合はご相談ください。両方を並行して進めるケースも多いです。
      </p>
      <p class="to-service reveal">
        <a href="/kumamoto-ai-training/">熊本の企業向け生成AI研修を見る <span class="arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
