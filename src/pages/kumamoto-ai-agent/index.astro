---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';

// 「熊本 AI導入支援」「熊本 AIコンサル」「熊本 業務効率化 AI」「熊本 AI 導入 費用」の検索意図に応える専用ページ。
// /kumamoto-ai-training/ は「人が使えるようになる（研修）」、このページは「システムが動く（導入・自動化）」で
// 求める成果物が別物なため、ページを分ける正当性がある（地域名差し替えの量産ページではない）。
//
// 費用について: 金額は出さない方針（光太郎くん判断 2026-07-25）。
// かわりに「いま手作業にかかっている時間を人件費に換算する」考え方を示して判断材料にする。

const painPoints = [
  {
    q: '毎月おなじ資料を、人が手で作り直している',
    a: '定型の報告書・請求書・日報のような「フォーマットが決まっている仕事」は、AIエージェントがもっとも得意とする領域です。',
  },
  {
    q: '問い合わせ対応で、担当者の時間が溶けていく',
    a: '過去のやりとりと社内文書を読み込ませた一次対応の仕組みをつくると、人が判断すべき案件だけが手元に残ります。',
  },
  {
    q: 'AIを入れたいが、どの業務からやるべきか分からない',
    a: 'ここが最初の分かれ道です。効果が出る業務には共通の条件があるため、洗い出しと優先順位付けから一緒に行います。',
  },
];

// 「AIエージェントとは何か」の定義。チャットAIとの違いを、機能の羅列ではなく
// 「どこまでを人がやるか」の線引きで説明する。ここが分かれば残りのセクションが全部つながる。
const agentDefinition = [
  {
    era: 'ChatGPT・Gemini・Claude',
    label: 'チャットAI',
    title: '人が聞くと、AIが答える',
    desc: '下書きは出てきます。ただし、指示を出すのも、出てきたものを直して仕上げるのも人のままです。手を離すと止まります。',
  },
  {
    era: 'Claude Code・Codex',
    label: 'AIエージェント',
    title: '任せると、最後まで仕上がる',
    desc: '手順と判断の基準を渡しておけば、指示を待たずに工程を進め、成果物の形まで持っていきます。人が見るのは、外に出す前の最終確認だけです。',
  },
];

// 「代行する時代」の裏づけ。抽象論にならないよう、自社で実際に起きている事象に寄せる。
const delegationFacts = [
  {
    num: '18',
    unit: '本',
    title: '毎日・毎週・毎月の定時業務',
    desc: '朝の承認待ち報告、会議直後の次アクション整理、夜の録画整理、その日の日報。時間になれば、誰も呼ばなくても動きます。',
  },
  {
    num: '約4',
    unit: '割',
    title: '人が指示していない時間帯の稼働',
    desc: '直近2週間の記録では、会社の資料への保存・更新279回のうち約4割が、こちらが何も指示していない時間に動いた分でした。',
  },
  {
    num: '8',
    unit: '割以上',
    title: '実務がAIエージェントで回っている割合',
    desc: '人間が担っているのは、外に出るものの最終確認と、判断が要る場面だけです。作業そのものはほとんど手元を離れました。',
  },
];

// AIを「担当者」として成立させるために資料室へ入れる3点。手順書だけで止まっている例が多いので、
// 残る2つ（判断の基準・過去の成果物）を明示して、次の「なぜ熊本の会社が有利か」へつなぐ。
const knowledgeSet = [
  {
    num: '1',
    title: '手順書',
    desc: '何をどの順番でやるか。「請求書を作って」と言われたら、どこの何を見て、どの形式で出すか。',
  },
  {
    num: '2',
    title: '判断の基準',
    desc: '手順に書ききれない、その担当だけの細かいクセ。「この客先は敬称を役職で書く」「この項目は必ず税抜きで出す」といったもの。',
  },
  {
    num: '3',
    title: '過去の成果物',
    desc: '実際に出したもの。良かったものを残しておくと、次からはそれに寄せてきます。',
  },
];

// 熊本の企業にAIエージェントが向く4つの理由。出典は自社ブログ /blog/kumamoto-ai-shain/。
// 「地方だから遅れている」ではなく「地方だから条件が揃っている」という逆の主張にしてある。
// 他社の導入支援ページにない中身なので、生成AIに引用される塊になることを狙っている。
const kumamotoReasons = [
  {
    num: '01',
    title: '人が辞めないので、判断の基準が濃く溜まっている',
    body:
      '3点のうち、いちばん差がつくのが<em>判断の基準</em>です。手順書は真似できますが、判断の基準は真似できません。そして判断の基準は、同じ仕事を長く続けた人の中にしか溜まりません。数年で人が入れ替わる会社にはこれが薄く、10年20年と同じ方が同じ仕事をしてきた会社には、驚くほど濃く溜まっています。',
    note:
      '属人化はリスクだと言われ続けてきました。ただ、AIに仕事を任せる前提に立つと、評価が逆転します。属人化した判断は、他社が持っていない材料そのものです。ベテランの方が辞める前に資料室へ移せれば、それは会社に残ります。',
  },
  {
    num: '02',
    title: '一人が何役もこなすので、1体つくったときの効き幅が大きい',
    body:
      '総務の方が経理も採用も、たまに広報も見ている。熊本では珍しくない体制です。分業が進んだ大きな会社では、1つの業務を任せても浮くのはその分だけです。<em>兼務が当たり前の会社では、1体つくると、その方が抱えている何本もの仕事のうち1本が丸ごと外れます。</em>同じ1体でも、効き幅が変わります。',
    note:
      '弊社の支援先では、ハウスメーカーで一人当たり月20時間以上の業務削減という結果が出ています。人数の多い会社より、一人が何役も持っている会社の方がこの形の効果は出やすい、という感触があります。',
  },
  {
    num: '03',
    title: '仕事の型が変わらないので、手順書が腐らない',
    body:
      '半年ごとにやり方が変わる会社では、手順書は書いた3ヶ月後には現場と合わなくなり、結局誰も見なくなります。AIエージェントも同じで、資料室の中身が現場とずれれば、出てくるものも的外れになります。<em>長く同じやり方で回してきた会社では、一度きちんと書けば効き続けます。</em>',
    note:
      '変化の遅さは、普段は弱みとして語られます。ただ、仕事をAIに任せる場面では有利に働きます。書いたものが長く使えるということだからです。',
  },
  {
    num: '04',
    title: '人が採れない前提で、設計できる',
    body:
      '募集を出しても応募がない、来ても定着しない。この話をお聞きしない月がありません。<em>誤解のないように書きますが、いまいる方を減らす話ではありません。</em>採用できなかった1人分の穴をどう埋めるか、という話です。',
    note:
      '事務職を1人採用すれば、人件費に加えて教育の時間がかかります。その予算と時間の一部を、繰り返しの事務作業を任せる仕組みに向けるという選択肢が、いまは現実的に取れます。しかもこの仕組みは辞めませんし、引き継ぎも要りません。',
  },
];

// 最初の1体を選ぶ基準。相談前にご自身で当てはめられる形にしておく。
const firstAgentQuestions = [
  'その仕事は、毎週やっていますか',
  '「いつもこう作る」という型がありますか',
  '社長やベテランの方でなくてもいい仕事ですか',
];

// うまくいかないパターン。都合の悪い話を先に書くことで、相談前の期待値を合わせる。
const failurePatterns = [
  {
    title: '直さない',
    desc: '出てきたものに赤を入れるが、その赤を資料室に書き戻さない。だから来週も同じものが出てきます。いちばん多いのがこれです。',
  },
  {
    title: '放っておく',
    desc: '作ったところで満足して3ヶ月触らない。その間に現場のやり方が動き、中身がずれていきます。',
  },
  {
    title: 'チャット画面に戻る',
    desc: '面倒になって、結局いつものAIに直接聞く生活へ戻る。仕組みが育たないまま止まります。',
  },
];

// 導入後に何が変わるか。抽象的な「効率化」ではなく、朝の30分・引き継ぎ・繁忙期という
// 中小企業の経営者が毎月実感している場面に寄せて書く。
const results = [
  {
    before: '朝いちばんの30分が、昨日の整理で消える',
    after: '出社したときには、整理が終わっている',
    desc: '日報、議事録、承認待ちの一覧。時間になれば動くので、人が席に着く前に片づいています。その30分が、そのまま本来の仕事に戻ります。',
  },
  {
    before: '「あれはあの人しか分からない」が残り続ける',
    after: '誰が聞いても、同じ答えが返ってくる',
    desc: '判断の基準が資料室にあるので、担当の方が休んでも、辞めても、出てくるものが変わりません。引き継ぎ資料を作り直す必要もなくなります。',
  },
  {
    before: '繁忙期は、残業か人を増やすかの二択',
    after: '件数が増えても、かかる時間はあまり変わらない',
    desc: '定型の処理は件数に比例して人手が増えるものですが、仕組みに移した部分はそうなりません。山の高さに人を合わせる必要が薄くなります。',
  },
];

// セキュリティ。士業・製造・建設からは必ず質問が出るため、一般論ではなく
// 「何を読ませないか」の設計として書く。過度な安全保証はしない。
const securityLayers = [
  {
    num: '01',
    title: '読ませる範囲を、最初に線引きする',
    desc: '資料室は自社のパソコンやサーバーの中のフォルダです。何を入れて何を入れないかを、こちらで決められます。見せたくないものは、そもそも資料室に置きません。外部のチャット画面に情報を貼り付ける使い方との一番の違いがここです。',
  },
  {
    num: '02',
    title: '外に出る前に、必ず人が確認する',
    desc: 'メール・SNS・公開文書はAIが下書きまでで止まり、送信ボタンは人が押します。見積・請求・申込のように数字が入るものは、人が検算してから確定します。',
  },
  {
    num: '03',
    title: '誰が何をしたか、記録が残る',
    desc: 'どの担当がいつ何をしたかが記録として残ります。口頭で回っていた作業より、あとから追いやすい状態になります。',
  },
];

// 業種ごとの設計の勘所。実名事例は出さず、業種名のとどめる方針に沿う。
const securityByIndustry = [
  { industry: '士業', point: '顧客情報と案件記録を、通常業務が読む範囲から外して別に管理します。' },
  { industry: '製造', point: '図面・原価・取引条件を切り分け、社外に出る文書の確認を厚めに設計します。' },
  { industry: '建設', point: '施主情報と見積の根拠を分け、金額が入る書類は必ず人の検算を通します。' },
  { industry: '医療・介護', point: '利用者情報は資料室に入れず、書式と手順だけを任せる設計から始めます。' },
];

// 「AIオフィス」の4段階。自社（WizTry）で実際に動かしている仕組みをそのまま説明する構成。
// 出典は自社ブログ /blog/ai-shain-tsukurikata/（AI社員10名の実録）。
// Google公式が「効く」と明言している一次情報（first-hand）にあたるため、他社が書けない中身にする。
const officeStages = [
  {
    num: '01',
    label: '整理整頓',
    title: '会社の情報を、AIが読める形に整える',
    body:
      'AIエージェントが働けない一番の理由は、AIの性能ではありません。<em>読むものが社内にない</em>ことです。人間の新入社員に業務マニュアルも議事録も渡さず「察して動け」と言っても無理なのと同じです。まずは会社の知識を、AIが毎回読み返せる形に整えます。',
    detail: [
      '判断の基準になる「会社の事実」を書き出す（事業内容、商品、お客様への言葉遣い、やってはいけないこと）',
      '散らばっている業務マニュアル・議事録・過去のやりとりを1か所に集める',
      '中身は特別な形式にしない。ただのテキストファイルにしておくと、どのAIでもそのまま読める',
    ],
    note:
      'すでに業務マニュアルや議事録があるなら、AIエージェントの教科書は半分できています。ゼロから発明する話ではありません。',
  },
  {
    num: '02',
    label: 'ナレッジ構造',
    title: '3層構造で「会社の資料室」をつくる',
    body:
      '集めただけでは使えません。AIが迷わず必要な情報にたどり着けるよう、階層を決めます。弊社が自社で運用している資料室は、この3層だけです。特別なシステムではなく、<em>フォルダとファイルの集まり</em>です。',
    detail: [
      '第1層 全社ルール — 誰が読んでも守れる決まりごと（例「メール返信は過去のやりとりを引用する」「ログイン情報には触らない」）',
      '第2層 部署のルール — 部署ごとに1枚。研修・営業・マーケティング・バックオフィスなど',
      '第3層 仕事の手順書 — 見積の作り方、日程調整の段取り、資料の作り方。新入社員に渡す業務マニュアルと同じもの',
    ],
    note:
      '大事なのは、ここにネットの一般論を入れないことです。入れると「一般的には正しいが自社では間違い」の答えが返ってくるようになります。入れるのは自社の事実だけです。',
  },
  {
    num: '03',
    label: 'AIオフィス',
    title: '担当を分けて、動く時間を決める',
    body:
      '資料室が整ったら、そこで働く「担当」を配置します。ポイントは<em>1人に1つの担当を持たせる</em>ことです。担当を曖昧にしたまま何でも頼むと、AIも人と同じで仕事が雑になります。',
    detail: [
      '業務ごとに担当を切る（メール担当、資料作成担当、議事録担当、日報担当など）',
      '定時業務として時間割を決める（朝の報告、会議後のフォロー、夜の記録整理など）',
      '毎日の記録が資料室に書き戻る設計にする。放っておいても会社の記憶が積み上がる状態をつくる',
    ],
    note:
      '弊社では担当ごとに名前を付けて10名分を運用しています。遊びに見えますが、「誰の仕事か」を曖昧にしないための実務上の工夫です。',
  },
  {
    num: '04',
    label: '安全な仕組み',
    title: '「関所」を決めてから、任せ切る',
    body:
      '最後に安全設計です。弊社の考え方は<em>AIが最後まで走り、外に出る直前に必ず人間の関所を通る</em>です。関所を増やしすぎると人間が渋滞の原因になり、少なすぎると事故が起きます。だから関所は3つに絞ります。',
    detail: [
      '外に出るもの（メール・SNS・公開文書）— AIは下書きまで。送信ボタンは人間が押す',
      'お金と契約（見積・請求・申込）— 数字は人間が検算してから確定する',
      '初めてやる種類の仕事 — 最初の1回だけ人間が横で見る',
    ],
    note:
      'あわせて、機密情報は最初から別フォルダに分けて通常業務で読む範囲を決めます。そして間違いが出たら叱るのではなくルールに書き足します。間違いの9割は、指示とルールの穴です。',
  },
];

// 費用の考え方: 金額ではなく「換算のしかた」と「確認すべき費用項目」を示す
const costItems = [
  {
    title: '初期構築',
    desc: '業務の洗い出し、試作、本番の作り込み。対象業務の数と、既存システムとつなぐ必要があるかで変わります。',
  },
  {
    title: '運用・改善',
    desc: '動かし始めてからの調整、対象業務の追加、モデル更新への追随。作って終わりにしないための費用です。',
  },
  {
    title: 'AIサービスの利用料',
    desc: 'ChatGPT・Gemini・ClaudeなどのAPIやプラン料金。使う人数と処理量で決まり、当社への支払いとは別枠です。',
  },
];

const stack = [
  { name: 'Claude Code', desc: 'コードを書いて動かすAIエージェント。業務ツールの自作と自動化の中核' },
  { name: 'Codex', desc: 'OpenAIの開発エージェント。既存コードの改修や検証に併用' },
  { name: 'Dify', desc: '社内文書を読み込ませたチャットボットの構築' },
  { name: 'Google Apps Script', desc: 'スプレッドシート・Gmail・カレンダーの自動連携' },
  { name: 'Gemini API / Google Workspace', desc: '普段使いのツールの中にAIを組み込む' },
];

const flow = [
  { step: '01', title: '課題ヒアリング', desc: '自動化する業務を洗い出し、効果と実現しやすさで優先順位をつけます。ここで「やらない業務」も決めます。' },
  { step: '02', title: 'PoC・試作', desc: '小さく作って、実際の業務データで効果を確認します。ここで見込みが立たなければ、本番に進みません。' },
  { step: '03', title: '本番構築', desc: '業務フローに組み込み、担当者が日常的に使える形にして社内展開します。' },
  { step: '04', title: '運用伴走', desc: '使われ方を見ながら改善し、対象業務を広げます。AI顧問として継続的にご相談いただけます。' },
];

const faq = [
  {
    q: '熊本のどのエリアまで対応していますか?',
    a: '熊本市に拠点があり、熊本県内全域へお伺いしています。打ち合わせは対面・オンラインのどちらでも可能で、構築作業自体はオンライン中心で進むため、遠方でも進行に支障はありません。近県のご相談も承ります。',
  },
  {
    q: 'AI導入の費用はどのくらいかかりますか?',
    a: '対象業務の数、既存システムとの連携の有無、運用をどこまでお任せいただくかで大きく変わるため、内容をお伺いしてからお見積りします。判断材料として、いま手作業にかかっている時間を人件費に換算してみるのが有効です。たとえば月20時間かかっている作業があれば、その担当者の時間単価×20時間が毎月消えている計算になります。ご相談時にこの試算からご一緒します。',
  },
  {
    q: '何から始めればいいですか?',
    a: 'まずは「毎月・毎週おなじ手順で繰り返している作業」を1つ挙げてください。頻度が高く手順が決まっている業務ほど、効果がはっきり出ます。逆に、毎回判断が変わる業務は最初の対象に向きません。',
  },
  {
    q: '小さく試すことはできますか?',
    a: 'できます。むしろ推奨しています。最初に1業務でPoC（試作）をつくり、実際の効果を確認してから広げる進め方です。見込みが立たなければ本番構築に進まない判断も含めてご提案します。',
  },
  {
    q: '社内にITに詳しい人がいなくても大丈夫ですか?',
    a: '大丈夫です。むしろ多くのお客様がその状態から始めています。仕組みは私たちが構築し、担当者の方には「使う」ところだけをお願いします。必要に応じて社内向けの操作説明も行います。',
  },
  {
    q: '属人化が進んでいるのですが、AI導入には不利ですか?',
    a: '逆です。AIに仕事を任せる前提では、属人化した判断は他社が持っていない材料になります。ベテランの方の頭の中にある「この客先は敬称を役職で書く」「この時期にこの条件の見積もりは通らない」といった基準は、手順書と違って真似ができません。本人が辞める前に文章として会社側へ移せれば、会社に残る資産になります。最初の作業は、まさにこの書き出しから始めます。',
  },
  {
    q: '機密情報をクラウドに出さずに済みますか?',
    a: '資料室は自社のパソコンやサーバーの中のフォルダとして持ちます。何を読ませて何を読ませないかをこちらで決められるため、見せたくないものはそもそも資料室に置かない、という制御ができます。外部のチャット画面に情報を貼り付ける使い方との一番の違いがここです。士業・製造・建設のお客様からは必ず出るご質問なので、読ませる範囲の線引きは初回の設計時に必ず決めます。',
  },
  {
    q: 'AIで人を減らすということですか?',
    a: 'ちがいます。いまいる方を減らす前提での支援は行っていません。ご相談の多くは「採用したいが応募が来ない」「その1人分の穴が埋まらない」という状態からのご依頼です。繰り返しの事務作業を仕組みへ移し、いまいる方が本来やるべき仕事に時間を戻すことを目的にしています。',
  },
  {
    q: '導入までにどのくらいの期間がかかりますか?',
    a: '1体目が実務で使える状態になるまで、おおむね1〜2ヶ月をみていただいています。前半は、ベテランの方の判断基準を聞き取って文章に書き出す作業が中心で、ここが最も時間のかかる工程です。2体目以降は土台ができているぶん、半分以下の期間で立ち上がります。',
  },
  {
    q: '研修とどちらを先にやるべきですか?',
    a: '社員が日常業務でAIを使えるようになりたいなら研修から、特定の業務を確実に自動化したいなら導入支援からです。両方をご希望の場合は、研修で全体のリテラシーを上げながら、並行して効果の大きい業務を自動化する進め方が多いです。',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '熊本の企業向けAIエージェント導入支援・業務自動化',
  serviceType: 'AIエージェント開発・業務自動化・AI導入コンサルティング',
  provider: { '@type': 'Organization', name: 'WizTry株式会社', url: 'https://wiztrydx.com' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: '熊本県' },
    { '@type': 'City', name: '熊本市' },
  ],
  description:
    '熊本の企業向けにAIエージェントの構築と業務自動化を支援。ベテランの属人化した判断基準を「会社の資料室」へ書き出し、AIが手順どおり最後まで仕上げる状態をつくります。WizTry自身、実務の8割以上をAIエージェントで運用。Claude Code・Codex・Dify・GASを用いて、問い合わせ対応・資料作成・データ集計などの定型業務を自動化します。小さく試して効果を確認してから本番構築へ進みます。',
  url: 'https://wiztrydx.com/kumamoto-ai-agent/',
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://wiztrydx.com/' },
    { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://wiztrydx.com/service/' },
    { '@type': 'ListItem', position: 3, name: '熊本のAIエージェント導入支援' },
  ],
};
---

<Base
  title="熊本のAIエージェント導入支援・業務自動化"
  description="熊本の企業向けAIエージェント導入支援。属人化した判断を「会社の資料室」へ移し、定型業務をAIが最後まで仕上げる状態をつくります。弊社は実務の8割以上をAIエージェントで運用。小さく試してから本番構築、熊本県内全域に対応。"
  onDark={true}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />

  <PageHero
    en="AI AGENT"
    jp="熊本のAIエージェント導入支援"
    desc="人を増やさずに、仕事の量を減らす。熊本の企業の定型業務を、AIエージェントで自動化します。"
    bg="/gen/scene-agent-dev.webp"
  />

  <!-- 導入 -->
  <section class="section">
    <div class="container narrow-copy">
      <p class="lead-copy reveal">
        熊本はいま、全国でも人の採り合いが激しい地域のひとつになりました。TSMCの進出をはじめとする半導体関連の集積が進み、働き手も、賃金の水準も、そちらへ引っ張られています。<em>もともと採用に苦労していた中小企業にとっては、条件がさらに厳しくなりました。</em>
      </p>
      <p class="lead-copy reveal reveal-d1">
        これは熊本だけの話ではありません。働き手が減っていくことは全国共通で、そのうえで熊本は、地域内の競争が先に激しくなった場所です。<em>AIで仕事のやり方を変えることは、いずれやることから、いま決めることに変わりつつあります。</em>
      </p>
      <p class="lead-copy reveal reveal-d2">
        人手不足は、採用だけでは解決しなくなりました。募集しても応募が来ない。来ても育つまで時間がかかる。その一方で、<em>人がやらなくてもいい仕事</em>が現場を圧迫し続けています。
      </p>
      <p class="lead-copy reveal reveal-d1">
        WizTryのAIエージェント導入支援は、この「人がやらなくてもいい仕事」を仕組みに置き換える支援です。研修が<em>人が使えるようになる</em>ための取り組みなら、こちらは<em>システムが動くようになる</em>ための取り組みです。
      </p>
      <p class="lead-copy reveal reveal-d1">
        机上の話ではありません。弊社自身、いまは<em>実務の8割以上をAIエージェントが回している</em>状態で会社を動かしています。このページで説明するのは、その仕組みをそのままお客様の会社へ移すための考え方と手順です。
      </p>
    </div>
  </section>

  <!-- AIエージェントとは何か -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="WHAT IS AN AI AGENT"
        title="AIエージェントとは何か"
        lead="ChatGPTやGeminiとは何が違うのか。まず、よく聞く名前で並べてみます。"
      />

      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          結論から言うと、<em>同じ会社が「チャット版」と「エージェント版」の2種類を出しています</em>。ふだん耳にするChatGPT・Gemini・Claudeはチャット版で、その裏にエージェント版があります。
        </p>
      </div>

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-chat-vs-agent.webp"
          alt="同じ会社がチャット版とエージェント版の2種類を出している対比図。ChatGPTとCodex、ClaudeとClaude Code、GeminiとGemini CLIが同じ行に並ぶ"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          横に並んでいるのが同じ会社の製品です。ChatGPTとCodexはOpenAI、ClaudeとClaude CodeはAnthropic、GeminiとGemini CLIはGoogle。弊社が導入支援で使うのは、主に右側のClaude CodeとCodexです。
        </p>
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          違いは賢さではありません。<em>仕上げまでを誰が持つか</em>です。チャットAIは道具なので、こちらが手に持って動かした分だけ働き、手を離せば止まります。電動ドリルと同じです。
        </p>
        <p class="lead-copy reveal reveal-d1">
          AIエージェントは担当者として置きます。担当者なら、そばで持っていなくても仕事が進みます。<em>ただし条件が1つあって、その担当者は会社のことを知っている必要があります。</em>この条件をどう満たすかが、このあとの中心の話です。
        </p>
      </div>

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-work-split.webp"
          alt="チャットAIはAIが下書きして人が仕上げる。AIエージェントはAIが最後までやり人は確認だけ、という帯グラフの比較"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          同じ「AIを使う」でも、人の手元に残る仕事の量が変わります。灰色が人、色が付いているところがAIの担当範囲です。
        </p>
      </div>

      <div class="grid grid--2 eras">
        {
          agentDefinition.map((d, i) => (
            <article class={`card era-card reveal reveal-d${i + 1}`}>
              <div class="era-body">
                <span class="era-step">{d.era}</span>
                <span class="era-label">{d.label}</span>
                <h3>{d.title}</h3>
                <p>{d.desc}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-flow-gate.webp"
          alt="AIエージェントが資料室を読み、作業し、下書きを完成させ、最後に人が確認してから外に出すまでの流れ図"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          指示が入ってから成果物が出るまで、AIエージェントは途中で会社の資料を読みに行きます。この参照先が用意されているかどうかで、出てくるものの質が決まります。
        </p>
      </div>
    </div>
  </section>

  <!-- AIエージェントが作業を代行する時代 -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="DELEGATION"
        title="AIエージェントが作業を代行する時代"
        lead="「いずれそうなる」という話ではありません。弊社ではすでにこの状態で会社が回っています。数字でお見せします。"
      />

      <div class="grid grid--3 grid--trio facts">
        {
          delegationFacts.map((f, i) => (
            <div class={`fact reveal reveal-d${i + 1}`}>
              <p class="fact-num">
                {f.num}
                <span class="fact-unit">{f.unit}</span>
              </p>
              <h3 class="fact-title">{f.title}</h3>
              <p class="fact-desc">{f.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="figure-wide reveal mt-64">
        <img
          src="/gen/diag-timetable.webp"
          alt="AIエージェントの時間割。7時30分に承認待ちを報告、会議後に次アクションを整理、23時30分に録画を整理、23時55分に日報を作成"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          弊社の定時業務のうち4本です。人が呼ばなくても、時間になれば動きます。人が退社したあとの時間帯に処理が終わっていることも珍しくありません。
        </p>
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          ここで大事なのは、<em>人がいなくなったわけではない</em>ことです。むしろ増えたのは考える時間のほうでした。作業に追われていた頃は手が回らなかった提案の準備や、お客様への一手先のご連絡に、その時間を回せるようになっています。
        </p>
      </div>
    </div>
  </section>

  <!-- こんな状態から始まります -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="SYMPTOMS"
        title="こんな状態から始まります"
        lead="ご相談の入口として多いのは、この3つです。"
      />
      <div class="pain-list">
        {
          painPoints.map((p, i) => (
            <div class={`pain-item reveal reveal-d${i + 1}`}>
              <p class="pain-q">「{p.q}」</p>
              <p class="pain-a">{p.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- なぜ熊本の会社に向いているのか（差別化セクション） -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="WHY KUMAMOTO"
        title="なぜ、熊本の会社に向いているのか"
        lead="AIエージェントは、都市部の大企業から入るものだと思われがちです。ただ、実際に手を動かしてみると、条件が揃っているのはむしろ地方の中小企業のほうでした。"
      />

      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          前提として、AIを道具から担当者に変える鍵は、AIの側の賢さではありません。<em>会社側に置く「資料室」の中身</em>です。そして資料室が資料室として成立するには、次の3つが要ります。
        </p>
      </div>

      <div class="grid grid--3 grid--trio knowledge-set">
        {
          knowledgeSet.map((k, i) => (
            <div class={`card knowledge-card reveal reveal-d${i + 1}`}>
              <span class="knowledge-num">{k.num}</span>
              <h3>{k.title}</h3>
              <p>{k.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="figure-wide reveal mt-40">
        <img
          src="/gen/diag-knowledge-room.webp"
          alt="会社の資料室は3層。第1層は全社ルール、第2層は部署のルール、第3層は仕事の手順書で、AIエージェントがそれを読む図"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          並べ方はこの3層だけです。上から順に、全社で守ること、部署ごとの決まり、実際の仕事の手順。AIは仕事のたびにここを読み返します。
        </p>
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          世の中でAI社員と呼ばれているものの多くは、1つ目の<em>手順書だけで止まっています</em>。残る2つは、買ってくることも借りてくることもできません。同じ仕事を、同じ人が、長く続けてきた会社にしか溜まらないからです。
        </p>
        <p class="lead-copy reveal reveal-d1">
          ここから先が、熊本の会社が有利な理由です。
        </p>
      </div>

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-zokujinka.webp"
          alt="属人化が資産に変わる流れ。ベテランの頭の中にある判断基準を書き出して会社の資料室へ移し、AIエージェントがそれを読む"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          ベテランの方の頭の中にある判断の基準を、辞める前に資料室へ移す。この一手が、属人化をリスクから資産へ変えます。
        </p>
      </div>

      <div class="reasons">
        {
          kumamotoReasons.map((r) => (
            <article class="reason reveal">
              <header class="reason-head">
                <span class="reason-num">{r.num}</span>
                <h3 class="reason-title">{r.title}</h3>
              </header>
              <p class="reason-body" set:html={r.body} />
              <p class="reason-note">{r.note}</p>
            </article>
          ))
        }
      </div>

      <div class="container narrow-copy">
        <p class="to-service reveal">
          <a href="/blog/kumamoto-ai-shain/">熊本の会社にAI社員が向いている4つの理由を詳しく読む <span class="arrow">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- 導入するとどうなるのか -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="RESULTS"
        title="熊本の会社がAIエージェントを導入すると、どうなるのか"
        lead="効率化という言葉だと伝わりにくいので、実際に変わる場面で書きます。ご支援先でよく起きる3つです。"
      />

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-before-after.webp"
          alt="AIエージェント導入前後の比較。朝30分は整理から出社時に整理済みへ、あの人しか分からないが誰に聞いても同じへ、繁忙期は残業が件数が増えても同じへ変わる"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
      </div>

      <div class="results">
        {
          results.map((r, i) => (
            <article class={`result reveal reveal-d${i + 1}`}>
              <div class="result-pair">
                <p class="result-before">{r.before}</p>
                <span class="result-arrow" aria-hidden="true">→</span>
                <p class="result-after">{r.after}</p>
              </div>
              <p class="result-desc">{r.desc}</p>
            </article>
          ))
        }
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          どれも、人を減らして生まれた変化ではありません。<em>これまで人がやらなくてもよかった作業が、手元から外れた結果</em>です。空いた時間をどこに使うかは、会社ごとに違っていいところだと思っています。
        </p>
      </div>
    </div>
  </section>

  <!-- AIオフィスの作り方（中核セクション） -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="AI OFFICE"
        title="AIオフィスの作り方——4つの段階"
        lead="個別の作業を自動化して終わりにはしません。社員の代わりにAIが働ける「オフィス」そのものをつくります。弊社が自社で毎日動かしている仕組みを、そのままお客様の会社に移植する考え方です。"
      />

      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          先に結論から言います。AIエージェントの本体は、高価なシステムでもオーダーメイドの開発でもありません。<em>会社の知識が整理された、ただのフォルダとファイルの集まり</em>です。
        </p>
        <p class="lead-copy reveal reveal-d1">
          弊社で起きているのは「AIが賢いから会社が回る」ではなく、<em>「資料室が揃っているから、どのAIが来ても同じ品質で働ける」</em>という状態です。だから順番が大事で、道具の導入から始めると、ほぼ失敗します。
        </p>
      </div>

      <div class="stages">
        {
          officeStages.map((s) => (
            <article class="stage reveal">
              <header class="stage-head">
                <span class="stage-num">{s.num}</span>
                <span class="stage-label">{s.label}</span>
                <h3 class="stage-title">{s.title}</h3>
              </header>
              <p class="stage-body" set:html={s.body} />
              <ul class="stage-detail">
                {s.detail.map((d) => <li>{d}</li>)}
              </ul>
              <p class="stage-note">{s.note}</p>
            </article>
          ))
        }
      </div>

      <div class="container narrow-copy">
        <h3 class="block-title reveal mt-64">この4段階を通すと、何が起きるか</h3>
        <p class="lead-copy reveal">
          先にお見せした<em>実務の8割以上がAIエージェントで回っている</em>状態は、弊社がこの4段階をそのまま自社で通した結果です。特別な開発をしたわけではありません。担当を分けた10名体制で、定時業務が18本動いているだけです。
        </p>
        <p class="lead-copy reveal reveal-d1">
          裏返すと、<em>4段階のどれかを飛ばすと止まります</em>。いちばん多いのは、01と02（情報を整えて資料室の形にする）を省いて、03（担当を置く）から始めてしまうことです。読むものがない担当者は、何度指示を出し直しても的外れなものを出し続けます。
        </p>
        <p class="to-service reveal">
          <a href="/blog/ai-shain-tsukurikata/">弊社のAI社員10名の実録を読む <span class="arrow">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- セキュリティ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="SECURITY"
        title="セキュリティは、企業様ごとに設計します"
        lead="「顧客の情報をAIに入れるのが怖い」。士業・製造・建設のお客様から必ず出るご質問です。これは正しい警戒だと思っています。"
      />

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-security.webp"
