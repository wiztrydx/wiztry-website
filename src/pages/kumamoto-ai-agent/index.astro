---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';

const pageTitle = '熊本のAI導入支援・業務自動化｜AIエージェントならWizTry株式会社';
const pageDescription =
  '熊本のAI導入支援・業務自動化ならWizTry。AIエージェントで定型業務を自動化し、まずは1業務から効果を確認して広げます。1人あたり月20時間以上を削減した支援事例、自社での実践、費用、安全設計、導入の流れを紹介。';

const pageIndex = [
  { href: '#capabilities', label: 'できること' },
  { href: '#case-study', label: '導入事例' },
  { href: '#cost', label: '費用' },
  { href: '#flow', label: '導入の流れ' },
  { href: '#faq', label: 'よくある質問' },
];

const capabilities = [
  {
    before: '毎月おなじ資料を、人が手で作り直している',
    after: '時間になれば、下書きができている',
    desc: '報告書・請求書・日報など、形が決まっている仕事を仕組みに移します。',
  },
  {
    before: '問い合わせ対応で、担当者の時間が減っていく',
    after: '人が判断すべき案件だけが残る',
    desc: '社内文書と過去のやりとりをもとに、よくある質問への一次対応を任せます。',
  },
  {
    before: '「あの人しか分からない」が残り続ける',
    after: '判断の基準が、会社に残る',
    desc: 'ベテランの方の判断を文章にし、担当者が変わっても使える形に整えます。',
  },
  {
    before: '繁忙期は、残業か採用で補うしかない',
    after: '件数が増えても、定型作業は増えにくい',
    desc: '繰り返し処理を人の手元から外し、お客様対応や判断が必要な仕事へ時間を戻します。',
  },
];

const agentTasks = [
  '営業資料作成',
  '研修資料作成',
  'メール返信の下書き',
  'ブログ更新',
  '請求書作成',
  '問い合わせ一次対応',
  '会議後の情報整理',
  '定時レポート',
];

const kumamotoReasons = [
  {
    num: '01',
    title: '人手不足を、採用だけで埋めにくい',
    desc: '採用して育てるまで待てない仕事が、現場には残っています。まず定型業務を1本外すことで、いまいる方の時間を戻せます。',
  },
  {
    num: '02',
    title: 'ベテランの判断が、社内に蓄積している',
    desc: '長く同じ仕事を担ってきた方の判断基準は、他社が買えない資産です。退職前に文章へ移せば、AIが参照できる会社の知識になります。',
  },
  {
    num: '03',
    title: '一人が複数の仕事を兼務している',
    desc: '総務・経理・採用などを兼務する体制では、繰り返し業務を1つ仕組みに移すだけでも、担当者が本来の仕事へ戻りやすくなります。',
  },
];

const flow = [
  {
    step: '01',
    title: '任せる1業務を選ぶ',
    desc: '毎週・毎月繰り返し、作り方の型がある業務を洗い出します。効果と実現しやすさを見て、最初の1本を決めます。',
  },
  {
    step: '02',
    title: '手順と判断を整理して試す',
    desc: '社内の資料とベテランの方の判断を整理し、小規模な試作をつくります。実際の仕事で効果が出るかを確認します。',
  },
  {
    step: '03',
    title: '本番業務へ組み込む',
    desc: '既存の業務フローやGoogle Workspaceなどとつなぎます。情報の範囲と、人が確認する場所もこの段階で決めます。',
  },
  {
    step: '04',
    title: '直した内容を仕組みに戻す',
    desc: '使いながら出た修正を手順へ書き戻し、同じ間違いを繰り返さない状態にします。安定後に、次の業務へ広げます。',
  },
];

const securityLayers = [
  {
    num: '01',
    title: '保存場所と送信範囲を分けて考える',
    desc: '資料のファイルを自社のパソコンやサーバーで管理することと、AIの処理時に情報が外部サービスへ送信されることは別の話です。利用するAI・契約プラン・設定ごとに確認します。',
  },
  {
    num: '02',
    title: 'AIに読ませる情報を先に決める',
    desc: '機密区分と権限を確認し、参照させるファイル、送信する情報、対象外にする情報を業務ごとに線引きします。何でも読ませる設計にはしません。',
  },
  {
    num: '03',
    title: '外へ出す前に人が確認する',
    desc: 'メール・公開文書・見積・契約など、外に出るものやお金が動くものは人が最終確認します。AIへ任せる範囲と、人が判断する範囲を分けます。',
  },
];

const costItems = [
  {
    title: '初期の整理・試作',
    desc: '対象業務の洗い出し、手順の整理、小規模な試作。業務の数と資料の状態で変わります。',
  },
  {
    title: '本番構築・連携',
    desc: '既存のシステムやGoogle Workspaceとの連携、権限・確認工程の設計。つなぐ範囲で変わります。',
  },
  {
    title: '運用・AI利用料',
    desc: '導入後の改善支援と、利用するAIサービスの料金。契約プランと利用量を分けてご案内します。',
  },
];

const faq = [
  {
    q: '熊本のどのエリアまで対応していますか？',
    a: '熊本市に拠点があり、熊本県内全域へ対応しています。打ち合わせは対面・オンラインのどちらでも可能です。近県のご相談も承ります。',
  },
  {
    q: 'AI導入の費用はどのくらいかかりますか？',
    a: '対象業務の数、既存システムとの連携、セキュリティ要件、運用支援の範囲で変わるため、内容を確認してからお見積りします。最初から全社展開を前提にせず、小規模な1業務の試作からご相談いただけます。',
  },
  {
    q: '何から始めればいいですか？',
    a: 'まずは「毎週・毎月、同じ手順で繰り返している仕事」を1つ挙げてください。頻度が高く、作り方の型がある業務ほど、最初の対象に向いています。',
  },
  {
    q: '社内にITに詳しい人がいなくても大丈夫ですか？',
    a: '大丈夫です。現場の担当者の方には、普段の手順と判断のしかたを教えていただきます。技術の選定、試作、連携、運用設計はWizTryが支援します。',
  },
  {
    q: '機密情報はどのように扱いますか？',
    a: 'ファイルの保存場所と、AI処理時のデータ送信は分けて確認します。AIに参照させる情報、対象外にする情報、利用するモデル・契約プラン・保存設定を業務ごとに整理し、外部へ出す前には人の確認を入れます。',
  },
  {
    q: 'AIで人を減らすということですか？',
    a: 'いまいる方を減らすことを前提にした支援ではありません。繰り返しの事務作業を仕組みへ移し、お客様対応や経営判断など、人が担うべき仕事へ時間を戻すことが目的です。',
  },
  {
    q: '導入までにどのくらいかかりますか？',
    a: '対象業務の複雑さ、手順書や社内資料の状態、必要なシステム連携で変わります。最初の相談で業務を確認し、試作と本番導入それぞれの目安をお伝えします。',
  },
  {
    q: 'AI研修と導入支援は、どちらを選べばいいですか？',
    a: '社員が日常業務でAIを使えるようになりたい場合は研修、特定の業務を仕組みとして自動化したい場合は導入支援が向いています。両方を並行して進めることもできます。',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '熊本のAI導入支援・業務自動化',
  serviceType: 'AI導入支援・AIエージェント開発・業務自動化',
  provider: {
    '@type': 'Organization',
    name: 'WizTry株式会社',
    url: 'https://wiztrydx.com',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: '熊本県' },
    { '@type': 'City', name: '熊本市' },
  ],
  description: pageDescription,
  url: 'https://wiztrydx.com/kumamoto-ai-agent/',
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://wiztrydx.com/' },
    { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://wiztrydx.com/service/' },
    { '@type': 'ListItem', position: 3, name: '熊本のAI導入支援・業務自動化' },
  ],
};
---

<Base fullTitle={pageTitle} description={pageDescription} onDark={true}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />

  <div class="agent-page">
    <PageHero
      en="AI IMPLEMENTATION"
      jp="熊本のAI導入支援・業務自動化"
      desc="AIエージェントで、人を増やさずに仕事の量を減らす。"
      bg="/gen/scene-agent-dev.webp"
    />

    <section class="section section--tight intro-section" aria-label="AI導入支援の概要">
      <div class="container">
        <div class="reading-column">
          <p class="intro-lead reveal">
            WizTryのAI導入支援は、熊本の企業に残る繰り返し業務を、<strong>AIエージェントが最後まで進められる仕組み</strong>へ変える支援です。ツールを入れて終わりではなく、業務の整理、試作、本番導入、運用改善まで伴走します。
          </p>
          <div class="quick-start reveal reveal-d1">
            <div>
              <span class="quick-start-label">SMALL START</span>
              <h2>1業務の小さな試作から始められます</h2>
              <p>本番導入の費用は、業務数・連携範囲・セキュリティ要件で変わります。最初から大規模な開発を前提にする必要はありません。</p>
            </div>
            <a class="btn btn--primary" href="/contact/">1業務を相談する <span class="arrow">→</span></a>
          </div>

          <nav class="page-index reveal" aria-label="このページの目次">
            <p>知りたい項目から読めます</p>
            <ul>
              {pageIndex.map((item) => <li><a href={item.href}>{item.label}<span aria-hidden="true">↓</span></a></li>)}
            </ul>
          </nav>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="case-study">
      <div class="container">
        <div class="reading-column">
          <SectionHead
            en="CASE STUDY"
            title="AI導入支援の事例"
            lead="成果が確認できている事例を、公開可能な範囲でご紹介します。"
          />
        </div>

        <article class="case-showcase wide-column reveal">
          <div class="case-media">
            <img
              src="/gen/case-housemaker.webp"
              alt="ハウスメーカーでAIエージェントを導入し、1人あたり月20時間以上を削減した事例のイメージ"
              loading="lazy"
              decoding="async"
              width="1024"
              height="1024"
            />
          </div>
          <div class="case-content">
            <span class="case-label">匿名事例</span>
            <h3>ハウスメーカーの業務エージェント導入</h3>
            <p class="case-summary">定型業務をAIエージェントへ移し、空いた時間をお客様対応と提案品質の向上へ充てられる状態をつくりました。</p>
            <p class="case-result"><strong>月20時間以上</strong><span>1人あたりの業務時間を削減</span></p>
            <dl class="case-facts">
              <div><dt>業種</dt><dd>ハウスメーカー</dd></div>
              <div><dt>導入前の課題</dt><dd>定型業務が担当者の時間を圧迫</dd></div>
              <div><dt>導入した仕組み</dt><dd>業務エージェント</dd></div>
              <div><dt>削減時間</dt><dd>1人あたり月20時間以上</dd></div>
              <div><dt>導入期間</dt><dd>対象業務と連携範囲により変動</dd></div>
            </dl>
            <p class="case-note">※守秘のため社名と対象業務の詳細は非公開です。導入期間の目安は、業務を確認したうえでご案内します。</p>
          </div>
        </article>
      </div>
    </section>

    <section class="section" id="capabilities">
      <div class="container">
        <div class="reading-column">
          <SectionHead
            en="WHAT CHANGES"
            title="AI導入支援で、具体的に何が変わるか"
            lead="AIエージェントは、AI導入を実務の変化までつなげるための手段です。チャットAIとの違いは、仕上げまでを誰が担うかにあります。"
          />

          <div class="agent-compare reveal">
            <article>
              <span>ChatGPT・Claude・Gemini</span>
              <h3>チャットAIは、聞くと答える</h3>
              <p>人が指示し、出てきた下書きを人が直して仕上げます。手を離すと仕事は止まります。</p>
            </article>
            <article class="agent-compare-primary">
              <span>Claude Code・Codexなど</span>
              <h3>AIエージェントは、任せた工程を進める</h3>
              <p>手順と判断の基準を読み、成果物の形まで進めます。人は外へ出す前の確認と意思決定を担います。</p>
            </article>
          </div>
        </div>

        <div class="capability-grid wide-column">
          {capabilities.map((item, index) => (
            <article class={`change-card reveal reveal-d${(index % 4) + 1}`}>
              <p class="change-before">導入前<span>{item.before}</span></p>
              <span class="change-arrow" aria-hidden="true">↓</span>
              <p class="change-after">導入後<span>{item.after}</span></p>
              <p class="change-desc">{item.desc}</p>
            </article>
          ))}
        </div>

        <div class="reading-column">
          <div class="fit-panel reveal">
            <h3>最初の1業務に向いているもの</h3>
            <p>「毎週・毎月ある」「作り方の型がある」「重い経営判断を含まない」のうち、2つ以上が当てはまる業務です。</p>
            <ul>
              <li>請求書の作成</li>
              <li>定型メールの下書き</li>
              <li>議事録の整理</li>
              <li>決まった形式の報告書</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--navy proof-section">
      <div class="container">
        <div class="reading-column">
          <SectionHead
            en="WHY WIZTRY"
            title="自社で使い切っているから、運用まで設計できます"
            lead="WizTry自身が、毎日動くAIエージェントを社内業務で運用しています。机上の一般論ではなく、実際に止まった点や直し方まで支援へ反映します。"
          />
        </div>

        <div class="proof-grid wide-column">
          <div class="headline-stat reveal">
            <p class="headline-num">8<span>割以上</span></p>
            <p class="headline-label">当社の実務で、AIエージェントが作業を担う割合</p>
          </div>
          <div class="proof-tasks reveal reveal-d1">
            <p class="proof-tasks-title">実際に任せている業務</p>
            <ul class="task-list">
              {agentTasks.map((task) => <li>{task}</li>)}
            </ul>
            <p class="proof-sub">累計90社以上の支援を続けながら、定時業務18本を社内で運用しています。</p>
          </div>
        </div>
        <p class="proof-note wide-column reveal">
          ※「実務の8割以上」は、当社が定義する定型業務・資料作成・情報整理等の作業時間に占める割合（2026年7月時点の社内集計）です。最終確認・経営判断・送信・契約や金額の確定など、対外的な意思決定は人が実施しています。
        </p>
      </div>
    </section>

    <section class="section section--alt" id="why-kumamoto">
      <div class="container">
        <div class="reading-column">
          <SectionHead
            en="WHY KUMAMOTO"
            title="熊本の企業が、いまAI導入に取り組む理由"
            lead="人手不足と属人化は、AI導入の弱点ではありません。仕事の手順と判断を会社へ残すきっかけになります。"
          />
        </div>
        <div class="reason-grid wide-column">
          {kumamotoReasons.map((reason, index) => (
            <article class={`reason-card reveal reveal-d${index + 1}`}>
              <span>{reason.num}</span>
              <h3>{reason.title}</h3>
              <p>{reason.desc}</p>
            </article>
          ))}
        </div>
        <div class="reading-column">
          <p class="inline-link reveal">
            <a href="/blog/kumamoto-ai-shain/">熊本の会社にAI社員が向いている理由を詳しく読む <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="flow">
      <div class="container">
        <div class="reading-column">
          <SectionHead
            en="PROCESS"
            title="AI導入支援の流れ"
            lead="最初から全社へ広げず、1業務で効果と安全性を確認してから本番導入へ進みます。"
          />
        </div>

        <ol class="flow-grid wide-column">
          {flow.map((item, index) => (
            <li class={`flow-card reveal reveal-d${index + 1}`}>
              <span>STEP {item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </li>
          ))}
        </ol>

        <div class="reading-column">
          <div class="reality-panel reveal">
            <h3>導入で失敗しないための3原則</h3>
            <ol>
              <li><strong>小さく始める</strong><span>最初から「営業を全部」のような大きな単位を選ばない。</span></li>
              <li><strong>直した内容を戻す</strong><span>AIの出力へ入れた修正を、その場で手順とルールへ書き戻す。</span></li>
              <li><strong>運用を止めない</strong><span>現場のやり方が変わったら、AIが読む情報も同時に更新する。</span></li>
            </ol>
            <p>導入期間は、対象業務・社内資料の状態・必要な連携で変わります。初回相談で試作と本番導入の目安を分けてお伝えします。</p>
          </div>
        </div>

        <div class="training-choice wide-column reveal">
          <article>
            <span>社員が使えるようになりたい</span>
            <h3>生成AI研修</h3>
            <p>社員一人ひとりが、日常業務でAIを使える状態をつくります。</p>
            <a href="/kumamoto-ai-training/">熊本の生成AI研修を見る <span aria-hidden="true">→</span></a>
          </article>
          <article>
            <span>業務そのものを仕組みに任せたい</span>
            <h3>AI導入支援</h3>
            <p>特定の業務を、担当者が変わっても動く仕組みへ変えます。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="security">
      <div class="container">
        <div class="reading-column">
          <SectionHead
            en="SECURITY"
            title="ファイル管理とAIへのデータ送信は、分けて設計します"
            lead="「自社のパソコンに保存しているから、情報が外へ出ない」とは限りません。保存場所、送信範囲、契約プラン、確認工程を別々に確認します。"
          />
        </div>
        <div class="security-grid wide-column">
          {securityLayers.map((item, index) => (
            <article class={`security-card reveal reveal-d${index + 1}`}>
              <span>{item.num}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </article>
          ))}
        </div>
        <p class="security-note reading-column reveal">
          絶対に事故が起きない仕組みはありません。だからこそ、利用するサービスの仕様を確認し、どこまでをAIへ任せ、どこから人が判断するかを導入前に決めます。
        </p>
      </div>
    </section>

    <section class="section" id="cost">
