---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';

// 「熊本 AI導入支援」「熊本 AIコンサル」「熊本 業務効率化 AI」「熊本 AI 導入 費用」の検索意図に応える専用ページ。
// /kumamoto-ai-training/ は「人が使えるようになる（研修）」、このページは「システムが動く（導入・自動化）」で
// 求める成果物が別物なため、ページを分ける正当性がある（地域名差し替えの量産ページではない）。
//
// 費用について: 金額は出さない方針（光太郎くん判断 2026-07-25）。
// かわりに「いま手作業にかかっている時間を人件費に換算する」考え方を示して判断材料にする。


// 「AIエージェントとは何か」の定義。チャットAIとの違いを、機能の羅列ではなく
// 「どこまでを人がやるか」の線引きで説明する。ここが分かれば残りのセクションが全部つながる。
const agentDefinition = [
  {
    era: 'ChatGPT・Claude・Gemini',
    label: 'チャットAI',
    title: '人が聞くと、AIが答える',
    desc: '下書きは出てきます。ただし、指示を出すのも、出てきたものを直して仕上げるのも人のままです。手を離すと止まります。',
  },
  {
    era: 'Claude Code・Codex',
    label: 'AIエージェント',
    title: '任せると、最後まで仕上がる',
    desc: '手順と判断の基準を渡しておけば、指示を待たずに工程を進め、成果物の形まで持っていきます。人が見るのは、外に出す前の最終確認だけです。',
  },
];

// 「代行する時代」の裏づけ。数字を並列にすると主役が埋もれるため、8割以上だけを大きく出す。
// 実際に任せている業務名を並べたほうが、割合よりも具体的に伝わる。
const agentTasks = [
  '営業資料作成',
  '研修資料作成',
  'メール返信',
  'ブログ更新',
  'SNS運用',
  '請求書作成',
  '問い合わせ対応',
  'HP作成',
];

// 熊本の企業にAIエージェントが向く3つの理由。出典は自社ブログ /blog/kumamoto-ai-shain/。
// 「地方だから遅れている」ではなく「地方だから条件が揃っている」という逆の主張にしてある。
// 他社の導入支援ページにない中身なので、生成AIに引用される塊になることを狙っている。
const kumamotoReasons = [
  {
    num: '01',
    title: '属人化したナレッジが、すでに社内に集積している',
    body:
      '熊本の企業では、同じ方が同じ仕事を10年20年と続けてこられたケースが珍しくありません。その結果、手順書には書ききれない判断の基準が、担当者の中に濃く溜まっています。<em>これは買ってくることも、借りてくることもできない材料です。</em>',
    note:
      '累計90社以上のご支援で、各社の担当者の方と業務の中身までお話ししてきました。そのなかで確信したのは、地方の中小企業ほどこの蓄積が厚いということです。属人化はリスクだと言われ続けてきましたが、AIに仕事を任せる前提に立つと評価が逆転します。ベテランの方が辞める前に文章へ移せれば、会社に残る資産になります。',
  },
  {
    num: '02',
    title: '全国的にまだ普及していないので、先に動けば差がつく',
    body:
      '生成AIを触ったことのある会社は、この2年でずいぶん増えました。ただ、<em>AIエージェントを業務に組み込んで毎日動かしている中小企業は、弊社が見てきた範囲ではまだ限られています。</em>やり方が固まりきっていない領域なので、先に始めた会社ほど経験が溜まります。',
    note:
      '弊社自身、1体目がまともに動くまでには相応の時間がかかりました。ただ、そこで溜まった知見は他社が短期間では追いつけません。いま着手する価値は、削減できる時間そのものより、この差のほうが大きいと考えています。',
  },
  {
    num: '03',
    title: '人手不足が特に深刻なので、導入が急務になっている',
    body:
      'TSMCの進出をはじめとする半導体関連の集積で、熊本は人材の獲得競争が激しくなりました。採用で埋めるという前提が、以前より通りにくくなっています。熊本の中小企業では総務の方が経理も採用も見ている、という体制も珍しくありません。<em>採れなかった1人分をどう埋めるかを、いま決める必要があります。</em>',
    note:
      '誤解のないように書きますが、いまいる方を減らす話ではありません。繰り返しの事務作業を仕組みへ移し、いまいる方が本来やるべき仕事に時間を戻すための選択肢です。兼務が当たり前の会社ほど、1本外れたときの効き幅が大きくなります。',
  },
];

// 最初の1体を選ぶ基準。相談前にご自身で当てはめられる形にしておく。
const firstAgentQuestions = [
  'その仕事は、毎週やっていますか',
  '「いつもこう作る」という型がありますか',
  '社長やベテランの方でなくてもいい仕事ですか',
];

// うまくいかないパターン。都合の悪い話を先に書くことで、相談前の期待値を合わせる。
const failurePatterns = [
  {
    title: '直さない',
    desc: '出てきたものに赤を入れるが、その赤を資料室に書き戻さない。だから来週も同じものが出てきます。いちばん多いのがこれです。',
  },
  {
    title: '放っておく',
    desc: '作ったところで満足して3ヶ月触らない。その間に現場のやり方が動き、中身がずれていきます。',
  },
  {
    title: 'チャット画面に戻る',
    desc: '面倒になって、結局いつものAIに直接聞く生活へ戻る。仕組みが育たないまま止まります。',
  },
];

// 導入後に何が変わるか。抽象的な「効率化」ではなく、朝の30分・引き継ぎ・繁忙期という
// 中小企業の経営者が毎月実感している場面に寄せて書く。
// ご相談時の状態（before）と、導入後に変わる場面（after）を1つにまとめたもの。
// もとは「こんな状態から始まります」と「導入するとどうなるか」の2章に分かれていたが、
// 同じ話の前後だったため統合した。
const results = [
  {
    before: '毎月おなじ資料を、人が手で作り直している',
    after: '時間になれば、出来上がっている',
    desc: '定型の報告書・請求書・日報のように形が決まっている仕事は、AIエージェントがもっとも得意とする領域です。',
  },
  {
    before: '問い合わせ対応で、担当者の時間が溶けていく',
    after: '人が判断すべき案件だけが、手元に残る',
    desc: '過去のやりとりと社内文書を読ませた一次対応をつくると、よくある質問はそこで片づきます。',
  },
  {
    before: '「あれはあの人しか分からない」が残り続ける',
    after: '誰が聞いても、同じ答えが返ってくる',
    desc: '判断の基準が資料室にあるので、担当の方が休んでも、辞めても、出てくるものが変わりません。',
  },
  {
    before: '繁忙期は、残業か人を増やすかの二択',
    after: '件数が増えても、かかる時間は変わらない',
    desc: '定型の処理は件数に比例して人手が要りますが、仕組みに移した部分はそうなりません。',
  },
];
// セキュリティ。士業・製造・建設からは必ず質問が出るため、一般論ではなく
// 「何を読ませないか」の設計として書く。過度な安全保証はしない。
const securityLayers = [
  {
    num: '01',
    title: '読ませる範囲を、最初に線引きする',
    desc: '資料室は自社のパソコンやサーバーの中のフォルダです。何を入れて何を入れないかを、こちらで決められます。見せたくないものは、そもそも資料室に置きません。外部のチャット画面に情報を貼り付ける使い方との一番の違いがここです。',
  },
  {
    num: '02',
    title: '外に出る前に、必ず人が確認する',
    desc: '確認を挟む場所は、外に出るもの・お金が動くもの・初めてやる仕事の3か所に絞ります。増やしすぎると人が渋滞の原因になり、少なすぎると事故が起きるためです。どこに置くかは業務を見てから決めます。',
  },
  {
    num: '03',
    title: '誰が何をしたか、記録が残る',
    desc: 'どの担当がいつ何をしたかが記録として残ります。口頭で回っていた作業より、あとから追いやすい状態になります。',
  },
];

// 業種ごとの設計の勘所。実名事例は出さず、業種名のとどめる方針に沿う。
const securityByIndustry = [
  { industry: '士業', point: '顧客情報と案件記録を、通常業務が読む範囲から外して別に管理します。' },
  { industry: '製造', point: '図面・原価・取引条件を切り分け、社外に出る文書の確認を厚めに設計します。' },
  { industry: '建設', point: '施主情報と見積の根拠を分け、金額が入る書類は必ず人の検算を通します。' },
  { industry: '医療・介護', point: '利用者情報は資料室に入れず、書式と手順だけを任せる設計から始めます。' },
];

// 「AIオフィス」の4段階。自社（WizTry）で実際に動かしている仕組みをそのまま説明する構成。
// 出典は自社ブログ /blog/ai-shain-tsukurikata/（AI社員10名の実録）。
// Google公式が「効く」と明言している一次情報（first-hand）にあたるため、他社が書けない中身にする。
const officeStages = [
  {
    num: '01',
    label: '整理整頓',
    title: '会社の情報を、AIが読める形に整える',
    body:
      'AIエージェントが働けない一番の理由は、AIの性能ではありません。<em>読むものが社内にない</em>ことです。人間の新入社員に業務マニュアルも議事録も渡さず「察して動け」と言っても無理なのと同じです。まずは会社の知識を、AIが毎回読み返せる形に整えます。',
    detail: [
      '会社の決まりごとを書き出す（商品、お客様への言葉遣い、やってはいけないこと）',
      '散らばっている業務マニュアル・議事録・過去のやりとりを1か所に集める',
    ],
  },
  {
    num: '02',
    label: '資料室づくり',
    title: '3層構造で「会社の資料室」をつくる',
    body:
      '集めただけでは使えません。AIが迷わず必要な情報にたどり着けるよう、階層を決めます。弊社が自社で運用している資料室は、この3層だけです。特別なシステムではなく、<em>フォルダとファイルの集まり</em>です。',
    detail: [
      '第1層 全社ルール — 誰が読んでも守る決まりごと',
      '第2層 部署のルール — 部署ごとに1枚',
      '第3層 仕事の手順書 — 見積の作り方、日程調整の段取りなど',
    ],
  },
  {
    num: '03',
    label: 'AIオフィス',
    title: '担当を分けて、動く時間を決める',
    body:
      '資料室が整ったら、そこで働く「担当」を配置します。ポイントは<em>1人に1つの担当を持たせる</em>ことです。担当を曖昧にしたまま何でも頼むと、AIも人と同じで仕事が雑になります。',
    detail: [
      '業務ごとに担当を切る（メール担当、資料作成担当、議事録担当など）',
      '動く時間を決める（朝の報告、会議後のフォロー、夜の記録整理など）',
      '毎日の記録が資料室に書き戻るようにして、放っておいても知識が溜まる形にする',
    ],
  },
  {
    num: '04',
    label: '安全な仕組み',
    title: '人が見る場所を決めてから、任せ切る',
    body:
      '最後に安全設計です。弊社の考え方は、<em>AIが最後まで走り、外に出る直前に必ず人の確認を通す</em>というものです。確認箇所を増やしすぎると人が渋滞の原因になり、少なすぎると事故が起きます。だから次の3つに絞ります。',
    detail: [
      '外に出るもの（メール・SNS・公開文書）— AIは下書きまで。送信ボタンは人間が押す',
      'お金と契約（見積・請求・申込）— 数字は人間が検算してから確定する',
      '初めてやる種類の仕事 — 最初の1回だけ人間が横で見る',
    ],
  },
];

// 費用の考え方: 金額ではなく「換算のしかた」と「確認すべき費用項目」を示す
const costItems = [
  {
    title: '初期構築',
    desc: '業務の洗い出し、試作、本番の作り込み。対象業務の数と、既存システムとつなぐ必要があるかで変わります。',
  },
  {
    title: '運用・改善',
    desc: '動かし始めてからの調整と、任せる業務を増やしていく分。AIが新しくなったときの手直しもここに入ります。',
  },
  {
    title: 'AIの利用料',
    desc: 'ChatGPTなどを使うための月々の料金です。使う人数と量で決まり、弊社へのお支払いとは別にかかります。',
  },
];

const stack = [
  { name: 'Claude Code', desc: '中心に使う道具。手順どおりに作業を進めて、成果物まで仕上げます' },
  { name: 'Codex', desc: '同じくエージェント。作ったものの点検や作り直しに併用します' },
  { name: 'Dify', desc: '社内の資料を読ませた問い合わせ窓口をつくるときに使います' },
  { name: 'Google Apps Script', desc: 'スプレッドシート・Gmail・カレンダーを自動でつなぎます' },
];

const flow = [
  { step: '01', title: '課題ヒアリング', desc: '自動化する業務を洗い出し、効果と実現しやすさで優先順位をつけます。ここで「やらない業務」も決めます。' },
  { step: '02', title: '小さく試す', desc: '1業務だけ作って、実際の仕事で効果を確かめます。ここで見込みが立たなければ、本番に進みません。' },
  { step: '03', title: '本番構築', desc: '業務フローに組み込み、担当者が日常的に使える形にして社内展開します。' },
  { step: '04', title: '運用伴走', desc: '使われ方を見ながら改善し、対象業務を広げます。AI顧問として継続的にご相談いただけます。' },
];

const faq = [
  {
    q: '熊本のどのエリアまで対応していますか?',
    a: '熊本市に拠点があり、熊本県内全域へお伺いしています。打ち合わせは対面・オンラインのどちらでも可能で、構築作業自体はオンライン中心で進むため、遠方でも進行に支障はありません。近県のご相談も承ります。',
  },
  {
    q: 'AI導入の費用はどのくらいかかりますか?',
    a: '対象業務の数、既存システムとの連携の有無、運用をどこまでお任せいただくかで大きく変わるため、内容をお伺いしてからお見積りします。判断材料として、いま手作業にかかっている時間を人件費に換算してみるのが有効です。たとえば月20時間かかっている作業があれば、その担当者の時間単価×20時間が毎月消えている計算になります。ご相談時にこの試算からご一緒します。',
  },
  {
    q: '何から始めればいいですか?',
    a: 'まずは「毎月・毎週おなじ手順で繰り返している作業」を1つ挙げてください。頻度が高く手順が決まっている業務ほど、効果がはっきり出ます。逆に、毎回判断が変わる業務は最初の対象に向きません。',
  },
  {
    q: '小さく試すことはできますか?',
    a: 'できます。むしろ推奨しています。最初に1業務だけ作って効果を確かめ、そのうえで広げる進め方です。見込みが立たなければ本番に進まない、という判断も含めてご提案します。',
  },
  {
    q: '社内にITに詳しい人がいなくても大丈夫ですか?',
    a: '大丈夫です。むしろ多くのお客様がその状態から始めています。仕組みは私たちが構築し、担当者の方には「使う」ところだけをお願いします。必要に応じて社内向けの操作説明も行います。',
  },
  {
    q: '属人化が進んでいるのですが、AI導入には不利ですか?',
    a: '逆です。AIに仕事を任せる前提では、属人化した判断は他社が持っていない材料になります。ベテランの方の頭の中にある「この客先は敬称を役職で書く」「この時期にこの条件の見積もりは通らない」といった基準は、手順書と違って真似ができません。本人が辞める前に文章として会社側へ移せれば、会社に残る資産になります。最初の作業は、まさにこの書き出しから始めます。',
  },
  {
    q: '機密情報をクラウドに出さずに済みますか?',
    a: '資料室は自社のパソコンやサーバーの中のフォルダとして持つため、見せたくないものはそもそも置かない、という制御ができます。読ませる範囲の線引きは初回の設計時に必ず決めます。業種ごとの考え方はセキュリティの項をご覧ください。',
  },
  {
    q: 'AIで人を減らすということですか?',
    a: 'ちがいます。いまいる方を減らす前提での支援は行っていません。ご相談の多くは「採用したいが応募が来ない」「その1人分の穴が埋まらない」という状態からのご依頼です。繰り返しの事務作業を仕組みへ移し、いまいる方が本来やるべき仕事に時間を戻すことを目的にしています。',
  },
  {
    q: '導入までにどのくらいの期間がかかりますか?',
    a: '1体目が実務で使える状態になるまで、おおむね1〜2ヶ月をみていただいています。前半は、ベテランの方の判断基準を聞き取って文章に書き出す作業が中心で、ここが最も時間のかかる工程です。2体目以降は土台ができているぶん、半分以下の期間で立ち上がります。',
  },
  {
    q: '研修とどちらを先にやるべきですか?',
    a: '社員が日常業務でAIを使えるようになりたいなら研修から、特定の業務を確実に自動化したいなら導入支援からです。両方をご希望の場合は、研修で全体のリテラシーを上げながら、並行して効果の大きい業務を自動化する進め方が多いです。',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '熊本の企業向けAIエージェント導入支援・業務自動化',
  serviceType: 'AIエージェント開発・業務自動化・AI導入コンサルティング',
  provider: { '@type': 'Organization', name: 'WizTry株式会社', url: 'https://wiztrydx.com' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: '熊本県' },
    { '@type': 'City', name: '熊本市' },
  ],
  description:
    '熊本の企業向けにAIエージェントの構築と業務自動化を支援。ベテランの属人化した判断基準を「会社の資料室」へ書き出し、AIが手順どおり最後まで仕上げる状態をつくります。WizTry自身、実務の8割以上をAIエージェントで運用。Claude Code・Codex・Dify・GASを用いて、問い合わせ対応・資料作成・データ集計などの定型業務を自動化します。小さく試して効果を確認してから本番構築へ進みます。',
  url: 'https://wiztrydx.com/kumamoto-ai-agent/',
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://wiztrydx.com/' },
    { '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://wiztrydx.com/service/' },
    { '@type': 'ListItem', position: 3, name: '熊本のAIエージェント導入支援' },
  ],
};
---

<Base
  title="熊本のAIエージェント導入支援・業務自動化"
  description="熊本の企業向けAIエージェント導入支援。属人化した判断を「会社の資料室」へ移し、定型業務をAIが最後まで仕上げる状態をつくります。弊社は実務の8割以上をAIエージェントで運用。小さく試してから本番構築、熊本県内全域に対応。"
  onDark={true}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />

  <PageHero
    en="AI AGENT"
    jp="熊本のAIエージェント導入支援"
    desc="人を増やさずに、仕事の量を減らす。熊本の企業の定型業務を、AIエージェントで自動化します。"
    bg="/gen/scene-agent-dev.webp"
  />

  <!-- 導入 -->
  <section class="section">
    <div class="container narrow-copy">
      <p class="lead-copy reveal">
        熊本はいま、全国でも人の採り合いが激しい地域のひとつになりました。TSMCの進出をはじめとする半導体関連の集積が進み、働き手も、賃金の水準も、そちらへ引っ張られています。<em>もともと採用に苦労していた中小企業にとっては、条件がさらに厳しくなりました。</em>
      </p>
      <p class="lead-copy reveal reveal-d1">
        募集しても応募が来ない。来ても育つまで時間がかかる。その一方で、<em>人がやらなくてもいい仕事</em>が現場を圧迫し続けています。人手不足は、もう採用だけでは解決しなくなりました。
      </p>
      <p class="lead-copy reveal reveal-d1">
        WizTryのAIエージェント導入支援は、この「人がやらなくてもいい仕事」を仕組みに置き換える支援です。研修が<em>人が使えるようになる</em>ための取り組みなら、こちらは<em>システムが動くようになる</em>ための取り組みです。
      </p>
      <p class="lead-copy reveal reveal-d1">
        机上の話ではありません。弊社自身、いまは<em>実務の8割以上をAIエージェントが回している</em>状態で会社を動かしています。このページで説明するのは、その仕組みをそのままお客様の会社へ移すための考え方と手順です。
      </p>
    </div>
  </section>

  <!-- AIエージェントとは何か -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="WHAT IS AN AI AGENT"
        title="AIエージェントとは何か"
        lead="ChatGPTやGeminiとは何が違うのか。まず、よく聞く名前で並べてみます。"
      />

      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          結論から言うと、<em>同じ会社が「対話AI（チャットAI）」と「エージェント」の2種類を出しています</em>。ふだん耳にするChatGPT・Claude・Geminiは対話AIのほうで、その裏にエージェントがあります。
        </p>
      </div>

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-chat-vs-agent.webp"
          alt="同じ会社が対話AIと開発エージェントの2種類を出している対比表。OpenAIはChatGPTとCodex、AnthropicはClaudeとClaude Code、GoogleはGeminiとAntigravity"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          横に並んでいるのが同じ会社の製品です。右側はいずれも開発者向けに出てきたエージェントですが、<em>やっていることは「手順どおりに作業を進めて仕上げる」</em>なので、事務作業にもそのまま使えます。弊社が導入支援で使うのは、主にClaude CodeとCodexです。
        </p>
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          違いは賢さではありません。<em>仕上げまでを誰が持つか</em>です。チャットAIは道具なので、こちらが手に持って動かした分だけ働き、手を離せば止まります。電動ドリルと同じです。
        </p>
        <p class="lead-copy reveal reveal-d1">
          AIエージェントは担当者として置きます。担当者なら、そばで持っていなくても仕事が進みます。<em>ただし条件が1つあって、その担当者は会社のことを知っている必要があります。</em>この条件をどう満たすかが、このあとの中心の話です。
        </p>
      </div>

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-work-split.webp"
          alt="チャットAIはAIが下書きして人が仕上げる。AIエージェントはAIが最後までやり人は確認だけ、という帯グラフの比較"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          同じ「AIを使う」でも、人の手元に残る仕事の量が変わります。灰色が人、色が付いているところがAIの担当範囲です。
        </p>
      </div>

      <div class="grid grid--2 eras">
        {
          agentDefinition.map((d, i) => (
            <article class={`card era-card reveal reveal-d${i + 1}`}>
              <div class="era-body">
                <span class="era-step">{d.era}</span>
                <span class="era-label">{d.label}</span>
                <h3>{d.title}</h3>
                <p>{d.desc}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-flow-gate.webp"
          alt="AIエージェントが資料室を読み、作業し、下書きを完成させ、最後に人が確認してから外に出すまでの流れ図"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          指示が入ってから成果物が出るまで、AIエージェントは途中で会社の資料を読みに行きます。この参照先が用意されているかどうかで、出てくるものの質が決まります。
        </p>
      </div>
    </div>
  </section>

  <!-- AIエージェントが作業を代行する時代 -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="DELEGATION"
        title="AIエージェントが作業を代行する時代"
        lead="「いずれそうなる」という話ではありません。弊社ではすでにこの状態で会社が回っています。数字でお見せします。"
      />

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-jisseki.webp"
          alt="弊社での実績。実務がAIエージェントだけで回る割合は8割以上。任せている業務は営業資料作成・研修資料作成・メール返信・ブログ更新・SNS運用・請求書作成・問い合わせ対応・HP作成"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
      </div>

      <div class="headline-stat reveal">
        <p class="headline-num">
          8<span class="headline-unit">割以上</span>
        </p>
        <p class="headline-label">弊社の実務が、AIエージェントだけで回っています</p>
      </div>

      <div class="tasks reveal">
        <p class="tasks-title">AIエージェントがやっている業務</p>
        <ul class="task-list">
          {agentTasks.map((t) => <li>{t}</li>)}
        </ul>
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          補足として、支援してきた企業は累計90社以上です。その集客から顧客対応までを、少人数の体制で回しています。社内では毎日・毎週・毎月動く定時業務が18本あり、時間になれば人が呼ばなくても動きます。
        </p>
      </div>

      <div class="figure-wide reveal mt-64">
        <img
          src="/gen/diag-timetable.webp"
          alt="AIエージェントの時間割。7時30分に承認待ちを報告、会議後に次アクションを整理、23時30分に録画を整理、23時55分に日報を作成"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          上の18本のうち、4本を抜き出したものです。人が呼ばなくても、時間になれば動きます。人が退社したあとの時間帯に処理が終わっていることも珍しくありません。
        </p>
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          累計90社以上のご支援を、<em>集客から顧客対応まで少人数の体制で回しています</em>。それができているのは、作業の大半をAIエージェントが引き受けているからです。人が担っているのは、外に出るものの最終確認と、判断が要る場面だけになりました。
        </p>
      </div>
    </div>
  </section>

  <!-- なぜ熊本の会社に向いているのか（差別化セクション） -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="WHY KUMAMOTO"
        title="なぜ、熊本の会社に向いているのか"
        lead="AIエージェントは、都市部の大企業から入るものだと思われがちです。ただ、実際に手を動かしてみると、条件が揃っているのはむしろ地方の中小企業のほうでした。"
      />

      <div class="conclusion reveal">
        <p class="conclusion-lead">先に結論です。</p>
        <p class="conclusion-body">
          熊本の中小企業は、<em>AIエージェントを動かすのに必要な材料を、すでに持っています。</em>理由は次の3つです。
        </p>
        <ol class="conclusion-list">
          {kumamotoReasons.map((r) => <li>{r.title}</li>)}
        </ol>
        <p class="conclusion-note">なぜこの3つが効くのか、順に説明します。</p>
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          前提はひとつだけです。<em>AIエージェントに必要なのは、会社のナレッジです。</em>高価なシステムでも、特別な開発でもありません。仕事の手順と判断の基準が社内に文章で残っていれば、AIはそれを読んで仕事を進められます。逆にそこが空のままでは、どのAIを入れても動きません。
        </p>
        <p class="lead-copy reveal reveal-d1">
          ここから、先に挙げた3つの理由を順に見ていきます。
        </p>
      </div>

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-zokujinka.webp"
          alt="属人化が資産に変わる流れ。ベテランの頭の中にある判断基準を書き出して会社の資料室へ移し、AIエージェントがそれを読む"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          ベテランの方の頭の中にある判断の基準を、辞める前に資料室へ移す。この一手が、属人化をリスクから資産へ変えます。
        </p>
      </div>

      <div class="reasons">
        {
          kumamotoReasons.map((r) => (
            <article class="reason reveal">
              <header class="reason-head">
                <span class="reason-num">{r.num}</span>
                <h3 class="reason-title">{r.title}</h3>
              </header>
              <p class="reason-body" set:html={r.body} />
              {r.note && <p class="reason-note">{r.note}</p>}
            </article>
          ))
        }
      </div>

      <div class="container narrow-copy">
        <p class="to-service reveal">
          <a href="/blog/kumamoto-ai-shain/">熊本の会社にAI社員が向いている理由を、もっと詳しく読む <span class="arrow">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- 導入するとどうなるのか -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="RESULTS"
        title="熊本の会社がAIエージェントを導入すると、どうなるのか"
        lead="ご相談でいちばん多いのは「どの業務からやればいいか分からない」という段階です。効率化という言葉だと伝わりにくいので、実際に変わる場面を並べます。"
      />

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-before-after.webp"
          alt="AIエージェント導入前後の比較。手で作り直すが時間になれば完成へ、問い合わせに追われるが判断だけが手元にへ、あの人しか分からないが誰に聞いても同じへ、繁忙期は残業が件数が増えても同じへ変わる"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
      </div>

      <div class="results">
        {
          results.map((r, i) => (
            <article class={`result reveal reveal-d${i + 1}`}>
              <div class="result-pair">
                <p class="result-before">{r.before}</p>
                <span class="result-arrow" aria-hidden="true">→</span>
                <p class="result-after">{r.after}</p>
              </div>
              <p class="result-desc">{r.desc}</p>
            </article>
          ))
        }
      </div>

      <div class="container narrow-copy">
        <p class="lead-copy reveal mt-40">
          弊社の支援先では、ハウスメーカーで一人当たり月20時間以上の業務削減という結果が出ています。どれも、人を減らして生まれた変化ではありません。<em>これまで人がやらなくてもよかった作業が、手元から外れた結果</em>です。空いた時間をどこに使うかは、会社ごとに違っていいところだと思っています。
        </p>
      </div>
    </div>
  </section>

  <!-- AIオフィスの作り方（中核セクション） -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="AI OFFICE"
        title="AIオフィスの作り方——4つの段階"
        lead="個別の作業を自動化して終わりにはしません。社員の代わりにAIが働ける「オフィス」そのものをつくります。弊社が自社で毎日動かしている仕組みを、そのままお客様の会社に移植する考え方です。"
      />

      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          弊社で起きているのは「AIが賢いから会社が回る」ではなく、<em>資料室が揃っているから、どのAIが来ても同じ品質で働ける</em>という状態です。<em>だから順番が大事で、道具の導入から始めるとほぼ失敗します。</em>
        </p>
      </div>

      <div class="stages">
        {
          officeStages.map((s) => (
            <article class="stage reveal">
              <header class="stage-head">
                <span class="stage-num">{s.num}</span>
                <span class="stage-label">{s.label}</span>
                <h3 class="stage-title">{s.title}</h3>
              </header>
              <p class="stage-body" set:html={s.body} />
              <ul class="stage-detail">
                {s.detail.map((d) => <li>{d}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="figure-wide reveal mt-40">
        <img
          src="/gen/diag-knowledge-room.webp"
          alt="会社の資料室は3層。第1層は全社ルール、第2層は部署のルール、第3層は仕事の手順書で、AIエージェントがそれを読む図"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
        <p class="figure-cap">
          段階02でつくる資料室の形です。特別なシステムではなく、フォルダとファイルの集まりです。AIは仕事のたびにここを読み返します。
        </p>
      </div>

      <div class="container narrow-copy">
        <h3 class="block-title reveal mt-64">この4段階を通すと、何が起きるか</h3>
        <p class="lead-copy reveal">
          先にお見せした<em>実務の8割以上がAIエージェントで回っている</em>状態は、弊社がこの4段階をそのまま自社で通した結果です。特別な開発をしたわけではありません。担当を分けた<em>AI社員10名</em>の体制で、定時業務が18本動いているだけです。
        </p>
        <p class="lead-copy reveal reveal-d1">
          裏返すと、<em>4段階のどれかを飛ばすと止まります</em>。いちばん多いのは、01と02（情報を整えて資料室の形にする）を省いて、03（担当を置く）から始めてしまうことです。読むものがない担当者は、何度指示を出し直しても的外れなものを出し続けます。
        </p>
        <p class="to-service reveal">
          <a href="/blog/ai-shain-tsukurikata/">弊社のAI社員10名の実録を読む <span class="arrow">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- セキュリティ -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="SECURITY"
        title="セキュリティは、企業様ごとに設計します"
        lead="「顧客の情報をAIに入れるのが怖い」。士業・製造・建設のお客様から必ず出るご質問です。これは正しい警戒だと思っています。"
      />

      <div class="figure-wide reveal">
        <img
          src="/gen/diag-security.webp"
          alt="セキュリティは3つで守る。読ませる範囲を決める、外に出す前に人が確認する、作業の記録が残る"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
      </div>

      <div class="security-layers">
        {
          securityLayers.map((s) => (
            <article class="security-layer reveal">
              <span class="security-num">{s.num}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            </article>
          ))
        }
      </div>

      <h3 class="block-title reveal mt-64">業種によって、線の引き方が変わります</h3>
      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          守り方の型は同じでも、<em>どこに線を引くかは業種で変わります</em>。初回の設計時に、実際の書類を見ながら決めていきます。
        </p>
      </div>
      <div class="industry-list">
        {
          securityByIndustry.map((s, i) => (
            <div class={`industry-item reveal reveal-d${(i % 3) + 1}`}>
              <span class="industry-name">{s.industry}</span>
              <span class="industry-point">{s.point}</span>
            </div>
          ))
        }
      </div>
      <p class="cost-note reveal">
        なお、絶対に事故が起きない仕組みは存在しません。弊社がお約束できるのは、<em>どこまでを任せ、どこから人が見るか</em>を先に決めて、その線を運用で守り続けることです。
      </p>
    </div>
  </section>

  <!-- 費用の考え方 -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        en="COST"
        title="AI導入支援の費用の考え方"
        lead="金額は対象業務の数と連携範囲で変わるためお見積りになりますが、判断のしかたは先にお伝えできます。"
      />
      <div class="container narrow-copy">
        <p class="lead-copy reveal">
          いちばん確実なのは、<em>いま手作業にかかっている時間を人件費に換算してみること</em>です。月20時間かかっている作業があれば、その担当者の時間単価×20時間が、毎月消えていることになります。年間なら240時間です。
        </p>
        <p class="lead-copy reveal reveal-d1">
          この「消えている金額」と、自動化にかかる費用を並べたときに前者が明らかに大きければ、投資判断はしやすくなります。ご相談時には、この試算からご一緒します。
        </p>
      </div>
      <h3 class="block-title reveal mt-64">確認しておきたい費用の内訳</h3>
      <div class="grid grid--3 grid--trio costs">
        {
          costItems.map((c, i) => (
            <div class={`card cost-card reveal reveal-d${i + 1}`}>
              <span class="cost-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="cost-note reveal">
        この3つを混ぜて総額だけを提示されると、あとから「これは別料金です」が出てきます。弊社は最初から切り分けてご案内しています。
      </p>
    </div>
  </section>

  <!-- 技術スタック -->
  <section class="section section--navy">
    <div class="container">
      <SectionHead
        en="STACK"
        title="使用する技術"
        lead="流行りのツールを並べるのではなく、実際の業務に組み込んで運用しているものだけを使います。"
      />
      <div class="stack-list">
        {
          stack.map((s, i) => (
            <div class={`stack-item reveal reveal-d${(i % 3) + 1}`}>
              <span class="stack-name">{s.name}</span>
              <span class="stack-desc">{s.desc}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 進め方 -->
  <section class="section">
    <div class="container">
      <SectionHead
        en="FLOW"
        title="進め方"
        lead="小さく試して、効果を確認してから広げます。最初から全社展開はしません。"
      />
      <div class="grid grid--4">
        {
