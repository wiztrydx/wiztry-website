  /* 失敗パターンは「やってはいけない」側の情報。中立のカードと同じ見た目だと
     読み飛ばされるため、警告色の縦罫と連番で別種類だと分かるようにする。
     連番はCSSカウンタで振るので本文のマークアップは触らない */
  .failures {
    counter-reset: failure;
  }

  .failure-card {
    padding: 26px 28px 26px 30px;
    border-left: 3px solid #e0913c;
  }

  .failure-card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    margin-bottom: 10px;
  }

  .failure-card h3::before {
    counter-increment: failure;
    content: counter(failure);
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fdf1e3;
    color: #b96b1c;
    font-family: var(--font-en);
    font-size: 14px;
    font-weight: 800;
  }

  .failure-card p {
    font-size: 14px;
    line-height: 2;
    color: var(--ink-soft);
  }

