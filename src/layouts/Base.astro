---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE, NAV, YOUTUBE } from '../data/site';

interface Props {
  title?: string;
  /** titleタグをテンプレート化せず、そのまま使うページ向け */
  fullTitle?: string;
  description?: string;
  /** ヘッダー背景が濃色ヒーローに重なるページは true（トップ・下層ヒーロー） */
  onDark?: boolean;
  ogImage?: string;
  /** og:image の実寸の高さ（幅は1200固定。記事サムネは675） */
  ogImageHeight?: number;
  /** 記事ページは 'article' */
  ogType?: string;
  /** サンクスページ等、検索結果に出したくないページは true */
  noindex?: boolean;
}

const {
  title,
  fullTitle,
  description = SITE.description,
  onDark = true,
  ogImage = '/og-cover.jpg',
  ogImageHeight = 630,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const pageTitle = fullTitle ?? (title
  ? `${title} | WizTry株式会社（熊本の生成AI研修・AIエージェント導入支援）`
  : 'WizTry株式会社｜熊本の生成AI研修・AIエージェント導入支援');
const canonical = new URL(Astro.url.pathname, SITE.domain).href;

// 構造化データ。生成AI（ChatGPT検索・Gemini・Claude等）が「熊本の生成AI研修会社」として
// 機械的に読み取れるよう、Organization に LocalBusiness を併記し地域・領域を明示する。
// 注: 満足度4.8は自社アンケートの自己申告値なので aggregateRating では宣言しない（本文表記のみ）。
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${SITE.domain}/#organization`,
  name: SITE.name,
  alternateName: ['WizTry', 'ウィズトライ', 'WizTry Inc.'],
  url: SITE.domain,
  email: SITE.email,
  telephone: '+81-80-6414-9171',
  logo: `${SITE.domain}/logos/mark-512.png`,
  image: `${SITE.domain}/og-cover.jpg`,
  foundingDate: '2023-07',
  founder: { '@type': 'Person', '@id': `${SITE.domain}/about/#ceo`, name: SITE.ceo },
  sameAs: [YOUTUBE.url, 'https://x.com/suematsu_wiztry'],
  areaServed: [
    { '@type': 'AdministrativeArea', name: '熊本県' },
    { '@type': 'City', name: '熊本市' },
    { '@type': 'AdministrativeArea', name: '九州' },
  ],
  knowsAbout: [
    '生成AI研修',
    'ChatGPT研修',
    'Gemini研修',
    'Claude活用',
    'AIエージェント導入支援',
    'DX支援',
    'リスキリング',
    '熊本県リスキリング応援補助金',
    '人材開発支援助成金',
  ],
  address: {
    '@type': 'PostalAddress',
    addressRegion: '熊本県',
    addressLocality: '熊本市西区',
    streetAddress: '春日1丁目14番1号 くまもと森都心プラザ2階 XOSS POINT. Room4',
    postalCode: '860-0047',
    addressCountry: 'JP',
  },
  description: SITE.description,
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Bing Webmaster Tools の所有権確認。確認済み状態を維持するため削除しないこと（ChatGPTの検索はBing依存） */}
    <meta name="msvalidate.01" content="A34430BCB1DA99E27BB64C91BEB620AD" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logos/mark-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/logos/mark-192.png" />
    <meta name="theme-color" content="#0a1630" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE.domain).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Outfit:wght@500;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      import.meta.env.PROD && (
        <>
          {/* Google Analytics 4 (本番ドメインのみ計測。SPA遷移のPVは拡張計測の履歴イベントで自動送信) */}
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7WT2FFMNZQ" />
          <script is:inline>
            if (/(^|\.)wiztrydx\.com$/.test(location.hostname)) {
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-7WT2FFMNZQ');
            }
          </script>
        </>
      )
    }
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="site-loader" id="siteLoader" aria-hidden="true">
      <span class="curtain curtain--top"></span>
      <span class="curtain curtain--bottom"></span>
      <div class="site-loader-inner">
        <div class="site-loader-logo">
          <img src="/logos/wiztry-logo-white.png" alt="" width="168" height="40" />
          <i class="logo-shine"></i>
        </div>
        <span class="site-loader-bar"><i></i></span>
        <span class="site-loader-count" id="loaderCount">0</span>
      </div>
      <div class="site-loader-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    </div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="cur" id="cur" aria-hidden="true"><i class="cur-dot"></i><i class="cur-ring"></i></div>
    <button class="to-top" id="toTop" aria-label="ページ上部へ戻る">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" />
      </svg>
    </button>
    <header class:list={['site-header', { 'on-dark': onDark }]} id="siteHeader">
      <div class="container inner">
        <a href="/" class="brand" aria-label="WizTry株式会社 トップページ">
          <img class="logo-dark" src="/logos/wiztry-logo.png" alt="WizTry" width="126" height="30" />
          <img class="logo-white" src="/logos/wiztry-logo-white.png" alt="WizTry" width="126" height="30" />
        </a>
        <button class="nav-toggle" id="navToggle" aria-label="メニュー" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <nav class="gnav" id="gnav">
          {NAV.map((item) => (
            <a
              href={item.href}
              class:list={[{ 'is-current': Astro.url.pathname.startsWith(item.href) }]}
              aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}
            >{item.label}</a>
          ))}
          <a href="/contact/" class="btn btn--primary">お問い合わせ <span class="arrow">→</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="top">
          <div class="brand">
            <img src="/logos/wiztry-logo-white.png" alt="WizTry株式会社" width="126" height="30" />
            <p class="addr">
              {SITE.name}<br />
              {SITE.address}<br />
              TEL: <a href={`tel:${SITE.tel.replaceAll('-', '')}`}>{SITE.tel}</a><br />
              {SITE.email}
            </p>
          </div>
          <div>
            <h4>SERVICE</h4>
            <ul>
              <li><a href="/service/#training">生成AI導入研修</a></li>
              <li><a href="/kumamoto-ai-training/">熊本の企業向け生成AI研修</a></li>
              <li><a href="/service/#agent">AIエージェント導入支援</a></li>
              <li><a href="/kumamoto-ai-agent/">熊本のAI導入支援・業務自動化</a></li>
              <li><a href="/service/#subsidy">補助金・助成金の活用</a></li>
              <li><a href="/works/">導入実績</a></li>
            </ul>
          </div>
          <div>
            <h4>COMPANY</h4>
            <ul>
              <li><a href="/about/">会社案内・理念</a></li>
              <li><a href="/blog/">ブログ</a></li>
              <li><a href="/contact/">お問い合わせ</a></li>
              <li><a href="/privacy/">プライバシーポリシー</a></li>
              <li>
                <a href={YOUTUBE.url} target="_blank" rel="noopener" aria-label="YouTubeチャンネル KOTARO AI & VIDEO">
                  ▶ YouTube（{YOUTUBE.name}）
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="foot-word" aria-hidden="true">WizTry</div>
        <div class="copy">
          <span>© {new Date().getFullYear()} WizTry Inc. All rights reserved.</span>
          <span>KUMAMOTO, JAPAN</span>
        </div>
      </div>
    </footer>

    <script>
      // ページ遷移でbodyが差し替わるため、window直付けのリスナーは1回だけ登録し、
      // 参照する要素はナビゲーションごとに更新する（多重登録によるカクつき防止）
      let headerEl: HTMLElement | null = null;
      let barEl: HTMLElement | null = null;
      let toTopEl: HTMLElement | null = null;
      const onScrollGlobal = () => {
        headerEl?.classList.toggle('is-solid', window.scrollY > 40);
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? window.scrollY / max : 0;
        if (barEl) barEl.style.width = `${p * 100}%`;
        if (toTopEl) {
          toTopEl.classList.toggle('is-show', window.scrollY > 600);
          toTopEl.style.setProperty('--p', String(p));
        }
      };
      let windowBound = false;

      // カスタムカーソル（精密ポインタのみ）。要素はページ遷移で差し替わるため
      // 参照はinitCursorで毎回取り直し、windowリスナーとrAFループは1本だけ保つ
      let curDot: HTMLElement | null = null;
      let curRing: HTMLElement | null = null;
      let curX = -100, curY = -100, ringX = -100, ringY = -100;
      let curRaf = 0;
      const curLoop = () => {
        ringX += (curX - ringX) * 0.16;
        ringY += (curY - ringY) * 0.16;
        if (curDot) curDot.style.transform = `translate3d(${curX}px, ${curY}px, 0)`;
        if (curRing) curRing.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
        curRaf = requestAnimationFrame(curLoop);
      };
      const CUR_TARGETS = 'a, button, .btn, .card, summary, .logo-cell, input, textarea, select, label';
      function initCursor() {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const wrap = document.getElementById('cur');
        if (!wrap) return;
        curDot = wrap.querySelector('.cur-dot');
        curRing = wrap.querySelector('.cur-ring');
        document.documentElement.classList.add('cur-on');
        if (!(window as any).__curBound) {
          (window as any).__curBound = true;
          window.addEventListener('pointermove', (e) => {
            curX = e.clientX;
            curY = e.clientY;
            if (!curRaf) curRaf = requestAnimationFrame(curLoop);
          }, { passive: true });
          document.addEventListener('pointerover', (e) => {
            if ((e.target as HTMLElement).closest?.(CUR_TARGETS)) document.documentElement.classList.add('cur-hover');
          });
          document.addEventListener('pointerout', (e) => {
            if ((e.target as HTMLElement).closest?.(CUR_TARGETS)) document.documentElement.classList.remove('cur-hover');
          });
        }
      }

      // 慣性スクロール（デスクトップ・精密ポインタのみ）。読み込み失敗時は素のスクロールのまま
      if (
        window.matchMedia('(pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        window.innerWidth > 900
      ) {
        import('lenis')
          .then(({ default: Lenis }) => {
            const lenis = new Lenis({ duration: 1.05 });
            (window as any).__lenis = lenis;
            document.documentElement.classList.add('lenis-on');
            const raf = (t: number) => {
              lenis.raf(t);
              requestAnimationFrame(raf);
            };
            requestAnimationFrame(raf);
          })
          .catch(() => {});
      }

      // ページ内アンカーはLenis経由で滑らかに（スキップリンクは除外＝フォーカス移動優先）
      document.addEventListener('click', (e) => {
        const lenis = (window as any).__lenis;
        if (!lenis) return;
        const a = (e.target as HTMLElement).closest?.('a[href^="#"]:not(.skip-link)');
        if (!a) return;
        const id = a.getAttribute('href') || '';
        if (id.length < 2) return;
        const target = document.getElementById(id.slice(1));
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target, { offset: -84 });
      });

      function initPage() {
        headerEl = document.getElementById('siteHeader');
        barEl = document.querySelector<HTMLElement>('.scroll-progress');
        toTopEl = document.getElementById('toTop');
        toTopEl?.addEventListener('click', () => {
          const lenis = (window as any).__lenis;
          if (lenis) lenis.scrollTo(0);
          else window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        // ClientRouterの遷移で<html>のclassがリセットされるため毎回付け直す
        if ((window as any).__lenis) document.documentElement.classList.add('lenis-on');
        initCursor();
        onScrollGlobal();
        if (!windowBound) {
          windowBound = true;
          window.addEventListener('scroll', onScrollGlobal, { passive: true });
        }

        // モバイルナビ
        const toggle = document.getElementById('navToggle');
        const gnav = document.getElementById('gnav');
        toggle?.addEventListener('click', () => {
          const open = gnav?.classList.toggle('open');
          toggle.classList.toggle('open', !!open);
          toggle.setAttribute('aria-expanded', String(!!open));
          document.body.style.overflow = open ? 'hidden' : '';
        });
        gnav?.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => {
            gnav.classList.remove('open');
            toggle?.classList.remove('open');
            document.body.style.overflow = '';
          })
        );

        // Reveal on scroll
        // 注意: thresholdに比率を使うと「画面より縦に長い要素」が永遠に発火しない
        // （比率の最大値=viewport/要素高がthreshold未満になるため）。0.01+rootMarginで判定する
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.01, rootMargin: '0px 0px -60px 0px' }
        );
        document.querySelectorAll('.reveal:not(.is-in)').forEach((el) => io.observe(el));

        // 数字カウントアップ（.count[data-to][data-decimals]）
        // HTMLには最初から実数値が入っている（SEO対策）。ここでは演出として0→実数値に数え上げるだけ。
        // モーション低減設定時は実数値のまま何もしない。
        const cio = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              cio.unobserve(e.target);
              if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
              const el = e.target as HTMLElement;
              const to = parseFloat(el.dataset.to || '0');
              const dec = parseInt(el.dataset.decimals || '0');
              const dur = 1400;
              const t0 = performance.now();
              const tick = (t: number) => {
                const p = Math.min((t - t0) / dur, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = (to * eased).toFixed(dec);
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            });
          },
          // revealのフェードインと同時にカウントが始まるように閾値を合わせる
          // （静的な実数値が一瞬見えてから0に戻る「ちらつき」を目立たなくする）
          { threshold: 0.01, rootMargin: '0px 0px -60px 0px' }
        );
        document.querySelectorAll('.count').forEach((el) => cio.observe(el));

        // 3Dチルト（.tilt）
        const fine = window.matchMedia('(pointer: fine)').matches;
        const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (fine && !noMotion) {
          document.querySelectorAll<HTMLElement>('.tilt').forEach((el) => {
            if (el.dataset.tiltReady) return;
            el.dataset.tiltReady = '1';
            if (!el.querySelector('.tilt-shine')) {
              const shine = document.createElement('span');
              shine.className = 'tilt-shine';
              el.appendChild(shine);
            }
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              const px = (e.clientX - r.left) / r.width;
              const py = (e.clientY - r.top) / r.height;
              el.style.transform = `perspective(900px) rotateX(${(0.5 - py) * 6}deg) rotateY(${(px - 0.5) * 8}deg) translateY(-4px)`;
              el.style.setProperty('--mx', `${px * 100}%`);
              el.style.setProperty('--my', `${py * 100}%`);
            });
            el.addEventListener('pointerleave', () => {
              el.style.transform = '';
            });
          });
        }
      }

      document.addEventListener('astro:page-load', initPage);

      // 初回ロードのブランドイントロ（セッション内1回だけ）: %カウント→分割カーテン
      // 重要: ClientRouterのページ遷移でbodyが差し替わるとローダーDOMが復活するため、
      // 遷移後は必ず除去する（過去に「0%のまま固まる」バグの原因になった）
      document.addEventListener('astro:after-swap', () => {
        document.getElementById('siteLoader')?.remove();
        document.documentElement.classList.remove('is-loading');
      });
      (() => {
        const loader = document.getElementById('siteLoader');
        if (!loader) return;
        let seen = true;
        try {
          seen = !!sessionStorage.getItem('wt-intro');
          if (!seen) sessionStorage.setItem('wt-intro', '1');
        } catch (e) {
          seen = true; // プライベートモード等では演出スキップ
        }
        if (seen || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          loader.remove();
          return;
        }
        try {
          document.documentElement.classList.add('is-loading');
          const count = document.getElementById('loaderCount');
          const DUR = 1200;
          const t0 = performance.now();
          let finished = false;
          const tick = (t: number) => {
            const p = Math.min((t - t0) / DUR, 1);
            if (count) count.textContent = String(Math.round((1 - Math.pow(1 - p, 2.2)) * 100));
            if (p < 1 && !finished) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          const done = () => {
            if (finished) return;
            finished = true;
            if (count) count.textContent = '100';
            loader.classList.add('is-done');
            document.documentElement.classList.remove('is-loading');
            setTimeout(() => loader.remove(), 1100);
          };
          window.addEventListener('load', () => setTimeout(done, Math.max(0, DUR - (performance.now() - t0)) + 100), { once: true });
          if (document.readyState === 'complete') setTimeout(done, DUR + 100);
          setTimeout(done, 2500); // 保険: 何があっても2.5秒で開く
        } catch (e) {
          loader.remove();
          document.documentElement.classList.remove('is-loading');
        }
      })();


      // タップ波紋（タッチ端末の全ボタン共通）
      if (window.matchMedia('(pointer: coarse)').matches) {
        document.addEventListener(
          'pointerdown',
          (e) => {
            const btn = (e.target as HTMLElement).closest('.btn');
            if (!btn) return;
            const r = btn.getBoundingClientRect();
            const rip = document.createElement('span');
            rip.className = 'tap-ripple';
            const size = Math.max(r.width, r.height);
            rip.style.width = rip.style.height = `${size}px`;
            rip.style.left = `${e.clientX - r.left}px`;
            rip.style.top = `${e.clientY - r.top}px`;
            btn.appendChild(rip);
            setTimeout(() => rip.remove(), 600);
          },
          { passive: true }
        );
      }

      // マグネティックボタン（primary系のみ・ポインタ精細時）
      if (window.matchMedia('(pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const magnetize = () => {
          document.querySelectorAll<HTMLElement>('.btn--primary:not([data-mag])').forEach((btn) => {
            btn.dataset.mag = '1';
            btn.addEventListener('pointermove', (e) => {
              const r = btn.getBoundingClientRect();
              const dx = e.clientX - (r.left + r.width / 2);
              const dy = e.clientY - (r.top + r.height / 2);
              btn.style.transform = `translate(${dx * 0.18}px, ${dy * 0.3}px)`;
            });
            btn.addEventListener('pointerleave', () => {
              btn.style.transform = '';
            });
          });
        };
        magnetize();
        document.addEventListener('astro:page-load', magnetize);
      }
    </script>
  </body>
</html>
